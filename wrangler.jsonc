{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-blog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
}
