{
  "name": "devadathanmb-blog",
  "version": "2.4.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "sync": "astro sync",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "pnpm run build && wrangler dev",
    "format": "prettier . --check --ignore-unknown",
    "format:write": "prettier . --write --ignore-unknown --cache",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "lint:fix": "eslint . --fix --cache",
    "toolbar:on": "astro preferences enable devToolbar",
    "toolbar:off": "astro preferences disable devToolbar",
    "prepare": "simple-git-hooks",
    "postbuild": "pagefind --site dist --exclude-selectors \"pre\" --include-characters \"<>\" && del-cli \"dist/pagefind/*ui*\"",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^9.37.0",
    "@expressive-code/plugin-collapsible-sections": "^0.43.1",
    "@expressive-code/plugin-line-numbers": "^0.43.1",
    "@iconify/json": "^2.2.464",
    "@types/node": "^24.7.2",
    "@types/nprogress": "^0.2.3",
    "@types/p5": "^1.7.7",
    "@typescript-eslint/parser": "^8.61.0",
    "@unocss/reset": "66.5.3",
    "astro": "^6.4.6",
    "astro-expressive-code": "^0.43.1",
    "astro-robots-txt": "^1.0.0",
    "chalk": "^5.6.2",
    "del-cli": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.4.0",
    "html-entities": "^2.6.0",
    "lint-staged": "^15.5.1",
    "mdast-util-to-string": "^4.0.0",
    "nprogress": "^0.2.0",
    "p5": "^1.11.13",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.1.2",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-wrap-all": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-directive-sugar": "^2.0.0",
    "remark-imgattr": "^1.1.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.34.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "unist-util-visit": "^5.1.0",
    "unocss": "66.5.3",
    "viewerjs": "^1.11.7",
    "wrangler": "^4.100.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm run format && pnpm run check"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro}": [
      "eslint --fix --cache"
    ],
    "src/pages/**/*.mdx": [
      "node scripts/bump-last-updated.mjs"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "simple-git-hooks"
    ],
    "overrides": {
      "minimatch": ">=3.1.4",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "defu": ">=6.1.5",
      "undici": ">=8.5.0",
      "fast-uri": ">=3.1.2",
      "fast-xml-builder": ">=1.1.7",
      "mdast-util-to-hast": ">=13.2.1",
      "yaml": ">=2.8.3",
      "postcss": ">=8.5.10",
      "ws": ">=8.20.1",
      "esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
