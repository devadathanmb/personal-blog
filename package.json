    "dayjs": "^1.11.13",
    "lodash.kebabcase": "^4.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "reading-time": "^1.5.0",
    "remark-collapse": "^0.1.2",
