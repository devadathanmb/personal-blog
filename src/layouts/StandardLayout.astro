---
interface Props {
  title?: string
  subtitle?: string
  isCentered?: boolean
  isSearchable?: boolean
  searchFilter?: string
  /** Shared with the post's list entry so the title glides between pages. */
  titleTransitionName?: string
  class?: string
}

const {
  title,
  subtitle,
  isCentered = false,
  isSearchable,
  searchFilter,
  titleTransitionName,
  class: className,
} = Astro.props
---

<header
  class:list={{
    'prose mx-auto mb-8': true,
    'text-center': isCentered,
  }}
>
  {
    title &&
      (titleTransitionName ? (
        <h1 class="font-medium" transition:name={titleTransitionName}>
          {title}
        </h1>
      ) : (
        <h1 class="font-medium">{title}</h1>
      ))
  }
  {subtitle && <p class="mt--4! op-50 italic">{subtitle}</p>}
  {
    /*
    The `head` slot is intentionally inside this `.prose` header — it holds
    title-block metadata (post date/reading time, "last updated", the now-page
    widgets) that's positioned within the prose flow via negative margins
    (e.g. `mt--6!`). Moving it out of `.prose` would break that spacing.
    Embedded interactive widgets should stay prose-resistant by scoping their
    own styles to a root class (see `.pill` in PillWidget.astro) rather than
    fighting `.prose` with `!important`, or pulling this slot out of the header.
  */
  }
  <slot name="head" />
</header>
{
  Astro.slots.has('article') && (
    <article
      class="slide-enter-content prose mx-auto"
      data-pagefind-body={isSearchable ? '' : undefined}
      data-pagefind-filter={
        isSearchable && searchFilter ? searchFilter : undefined
      }
    >
      <slot name="article" />
    </article>
  )
}
{
  Astro.slots.has('default') && (
    <div class:list={['mx-auto', className]}>
      <slot />
    </div>
  )
}
