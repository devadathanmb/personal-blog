---
import RenderPost from '~/components/views/RenderPost.astro'
import { getAdjacentPosts, getFilteredPosts } from '~/utils/data'

export async function getStaticPaths() {
  const posts = await getFilteredPosts('thoughts')

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }))
}

const { post, allPosts } = Astro.props
const adjacent = getAdjacentPosts(post, allPosts)
---

<RenderPost {post} {adjacent} isCommentable={true} />
