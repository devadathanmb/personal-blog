---
import { getCollection } from "astro:content";
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Posts from "@layouts/Posts.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";
import getReadingTime from "reading-time";

const posts = await getCollection("blog", ({ data }) => !data.draft);

// Calculate reading time for each post from body
const postsWithReadingTime = posts.map(post => {
  const readingTimeResult = getReadingTime(post.body!);
  return {
    ...post,
    data: {
      ...post.data,
      readingTime: readingTimeResult.text,
    },
  };
});

const sortedPosts = getSortedPosts(postsWithReadingTime);

// Create Page object manually for index page
const pageSize = SITE.postPerPage;
const totalPages = Math.ceil(sortedPosts.length / pageSize);
const paginatedPosts = sortedPosts.slice(0, pageSize);

const page: Page<CollectionEntry<"blog">> = {
  data: paginatedPosts,
  start: 0,
  end: Math.min(pageSize - 1, sortedPosts.length - 1),
  size: pageSize,
  total: sortedPosts.length,
  currentPage: 1,
  lastPage: totalPages,
  url: {
    current: "/posts",
    prev: undefined,
    next: totalPages > 1 ? "/posts/2" : undefined,
    first: "/posts",
    last: totalPages > 1 ? `/posts/${totalPages}` : "/posts",
  },
};
---

<Posts {page} />
