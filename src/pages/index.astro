---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import Hr from "@/components/Hr.astro";
import Terminal from "@/components/Terminal.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index">
    <section id="hero" class="mx-auto max-w-5xl px-4 pb-6 pt-8">
      <Terminal />

      <div class="my-8 sm:my-12">
        <Hr noPadding={true} />
      </div>

      {
        featuredPosts.length > 0 && (
          <>
            <div id="featured" class="pb-6 pt-8">
              <h2 class="mb-6 text-2xl font-semibold tracking-tight">Featured</h2>
              <ul>
                {featuredPosts.map(data => (
                  <Card variant="h3" {...data} />
                ))}
              </ul>
            </div>
            {recentPosts.length > 0 && (
              <div class="my-8">
                <Hr noPadding={true} />
              </div>
            )}
          </>
        )
      }

      {
        recentPosts.length > 0 && (
          <div id="recent-posts" class="pb-6 pt-8">
            <h2 class="mb-6 text-2xl font-semibold tracking-tight">Recent Posts</h2>
            <ul>
              {recentPosts.map(
                (data, index) =>
                  index < SITE.postPerIndex && <Card variant="h3" {...data} />
              )}
            </ul>
          </div>
        )
      }

      <div class="my-8 text-center">
        <LinkButton href="/posts/">
          All Posts
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
