---
import RenderPost from '~/components/views/RenderPost.astro'
import {
  getAdjacentPosts,
  getFilteredPosts,
  getSeriesNavigation,
} from '~/utils/data'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
  allPosts: CollectionEntry<'blog'>[]
}

export async function getStaticPaths() {
  const posts = await getFilteredPosts('blog')

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }))
}

const { post, allPosts } = Astro.props
const seriesNav = getSeriesNavigation(post, allPosts)
const adjacent = getAdjacentPosts(post, allPosts)
---

<RenderPost {post} {seriesNav} {adjacent} isCommentable={true} />
