---
import PillWidget from './PillWidget.astro'
import { FEATURES } from '~/config'

const { github } = FEATURES
const enabled = Array.isArray(github) && github[0]
const { username = '' } = enabled ? github[1] : {}
---

{
  enabled && username && (
    <PillWidget class="github-widget" data-username={username}>
      <div slot="icon" class="i-line-md:github-loop shrink-0 text-lg" />
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="gh-link flex flex-col justify-center max-w-[260px]"
      >
        <span
          id="gh-message"
          class="pill-primary text-xs font-medium leading-tight pill-loading truncate"
        >
          Loading...
        </span>
        <span
          id="gh-meta"
          class="pill-secondary text-[11px] leading-tight pill-loading truncate"
        >
          GitHub
        </span>
      </a>
    </PillWidget>
  )
}

<style>
  .gh-link,
  .gh-link:hover {
    border-bottom: none !important;
    color: inherit;
  }
  .gh-link:hover :global(.pill-primary) {
    color: #059669 !important;
  }
  :root.dark .gh-link:hover :global(.pill-primary) {
    color: #34d399 !important;
  }
</style>

<script>
  import { getRelativeTime } from '~/utils/datetime'

  interface GitHubEvent {
    type: string
    created_at: string
    repo: { name: string }
    payload: {
      head: string
      commits?: { message: string }[]
    }
  }

  async function fetchLastPush(username: string): Promise<{
    message: string
    repo: string
    time: string
    commitUrl: string
  } | null> {
    try {
      const res = await fetch(
        `https://api.github.com/users/${username}/events/public?per_page=30`,
        { headers: { Accept: 'application/vnd.github+json' } }
      )
      if (!res.ok) return null
      const events: GitHubEvent[] = await res.json()
      const push = events.find((e) => e.type === 'PushEvent')
      if (!push) return null

      const uts = Math.floor(new Date(push.created_at).getTime() / 1000)
      const commits = push.payload.commits ?? []
      const lastCommit = commits[commits.length - 1]
      const message = lastCommit?.message.split('\n')[0] ?? 'pushed'
      const repo = push.repo.name.split('/')[1] ?? push.repo.name
      const commitUrl = `https://github.com/${push.repo.name}/commit/${push.payload.head}`

      return { message, repo, time: getRelativeTime(uts), commitUrl }
    } catch {
      return null
    }
  }

  async function initGitHubWidget() {
    const widget = document.querySelector<HTMLElement>('.github-widget')
    if (!widget) return
    const username = widget.dataset.username
    if (!username) return

    const linkEl = widget.querySelector<HTMLAnchorElement>('a')
    const messageEl = widget.querySelector<HTMLElement>('#gh-message')
    const metaEl = widget.querySelector<HTMLElement>('#gh-meta')

    const result = await fetchLastPush(username)

    if (linkEl && result) linkEl.href = result.commitUrl
    if (messageEl) {
      messageEl.textContent = result?.message ?? 'github.com'
      messageEl.classList.remove('pill-loading')
    }
    if (metaEl) {
      metaEl.textContent = result ? `${result.repo} • ${result.time}` : username
      metaEl.classList.remove('pill-loading')
    }
  }

  document.addEventListener('astro:page-load', () => {
    initGitHubWidget()
  })
</script>
