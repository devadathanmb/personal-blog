---
import PillWidget from './PillWidget.astro'
import { FEATURES } from '~/config'

const { trakt } = FEATURES
const enabled = Array.isArray(trakt) && trakt[0]
const { username = '', clientId = '' } = enabled ? trakt[1] : {}
---

{
  enabled && username && clientId && (
    <PillWidget
      class="trakt-widget"
      data-username={username}
      data-clientid={clientId}
    >
      <div slot="icon" class="i-mdi:television-classic shrink-0 text-xl" />
      <a
        href={`https://trakt.tv/users/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="trakt-link flex flex-col justify-center max-w-[200px] sm:max-w-[250px]"
      >
        <span
          id="trakt-title"
          class="pill-primary text-xs font-medium leading-tight pill-loading truncate"
        >
          Loading...
        </span>
        <span
          id="trakt-meta"
          class="pill-secondary text-[11px] leading-tight pill-loading truncate"
        >
          Trakt
        </span>
      </a>
    </PillWidget>
  )
}

<style>
  .trakt-link,
  .trakt-link:hover {
    border-bottom: none !important;
    color: inherit;
  }
  .trakt-link:hover :global(.pill-primary) {
    color: #059669 !important;
  }
  :root.dark .trakt-link:hover :global(.pill-primary) {
    color: #34d399 !important;
  }
</style>

<script>
  import { fetchWatching } from '~/utils/trakt'
  import { getRelativeTime } from '~/utils/datetime'

  async function initTraktWidget() {
    const widget = document.querySelector<HTMLElement>('.trakt-widget')
    if (!widget) return

    const username = widget.dataset.username
    const clientId = widget.dataset.clientid
    if (!username || !clientId) return

    const linkEl = widget.querySelector<HTMLAnchorElement>('a')
    const titleEl = widget.querySelector<HTMLElement>('#trakt-title')
    const metaEl = widget.querySelector<HTMLElement>('#trakt-meta')

    const result = await fetchWatching(username, clientId)

    if (linkEl && result) linkEl.href = result.url
    if (titleEl) {
      titleEl.textContent = result?.title ?? 'trakt.tv'
      titleEl.classList.remove('pill-loading')
    }
    if (metaEl) {
      if (result) {
        const time = result.isWatching
          ? 'Watching now'
          : result.watchedAt
            ? getRelativeTime(result.watchedAt)
            : ''
        metaEl.textContent = result.subtitle
          ? `${result.subtitle} • ${time}`
          : time
      } else {
        metaEl.textContent = username
      }
      metaEl.classList.remove('pill-loading')
    }
  }

  document.addEventListener('astro:page-load', () => {
    initTraktWidget()
  })
</script>
