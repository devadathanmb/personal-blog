---
import { FEATURES } from '~/config'

interface Props {
  location?: string
  timezone?: string
  lat?: number
  lon?: number
}

const { location: locationFeature } = FEATURES
const enabled = Array.isArray(locationFeature) && locationFeature[0]
const featureConfig = enabled ? locationFeature[1] : null

const {
  location = featureConfig?.label ?? 'Unknown',
  timezone = featureConfig?.timezone ?? 'UTC',
  lat = featureConfig?.lat,
  lon = featureConfig?.lon,
} = Astro.props

const showWeather = lat !== undefined && lon !== undefined
const mapsUrl = lat !== undefined && lon !== undefined
  ? `https://www.google.com/maps?q=${lat},${lon}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(location)}`
const weatherUrl = `https://wttr.in/${encodeURIComponent(location)}`
---

<div
  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-[#1f1f1f] dark:hover:bg-[#2a2a2a] border border-gray-200 dark:border-[#333] text-sm font-medium w-fit transition-colors duration-200"
>
  <div class="i-ri-map-pin-line op-60 shrink-0 text-sm"></div>
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="lw-link lw-location-link text-xs"
  >{location}</a>

  {showWeather && (
    <>
      <span class="op-20 select-none text-[10px] mx-0.5">|</span>
      <!-- group on the anchor: only the temp span responds to hover, not the icon -->
      <a
        href={weatherUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="lw-link group inline-flex items-center gap-1"
      >
        <span
          class="lw-weather-icon op-70 shrink-0"
          data-lat={lat}
          data-lon={lon}
        ></span>
        <span class="lw-weather-temp font-mono text-xs tabular-nums lw-loading">
          --°
        </span>
      </a>
    </>
  )}

  <span class="op-20 select-none text-[10px] mx-0.5">|</span>

  <div class="i-lucide-watch op-60 shrink-0 text-sm"></div>
  <span
    class="font-mono text-emerald-600 dark:text-emerald-400 text-xs live-time-widget tracking-tight tabular-nums"
    data-timezone={timezone}
  >
    --:--:-- --
  </span>
</div>

<style>
  /* Kill underlines — theme draws them with border-bottom, not text-decoration */
  .lw-link,
  .lw-link:hover {
    border-bottom: none !important;
  }

  /* Force neutral color on location — prose global `a { color }` beats Tailwind utilities */
  .lw-location-link       { color: #e5e7eb !important; }  /* gray-200 */
  .lw-location-link:hover { color: #34d399 !important; }  /* emerald-400 */

  :root:not(.dark) .lw-location-link       { color: #1f2937 !important; }  /* gray-800 */
  :root:not(.dark) .lw-location-link:hover { color: #059669 !important; }  /* emerald-600 */

  /* Weather temp: neutral at rest, emerald on hover.
     Handled in CSS (not Tailwind group-hover) so !important beats the prose anchor specificity. */
  .lw-weather-temp                    { color: #e5e7eb; }           /* gray-200 */
  :root:not(.dark) .lw-weather-temp   { color: #1f2937; }           /* gray-800 */
  .group:hover .lw-weather-temp                  { color: #34d399 !important; }  /* emerald-400 */
  :root:not(.dark) .group:hover .lw-weather-temp { color: #059669 !important; }  /* emerald-600 */

  @keyframes lw-pulse {
    0%, 100% { opacity: 0.35; }
    50%       { opacity: 0.75; }
  }
  .lw-loading {
    animation: lw-pulse 1.4s ease-in-out infinite;
  }
</style>

<script>
  import { weatherIcon } from '~/utils/weather'

  async function fetchWeather(lat: number, lon: number) {
    try {
      const url = new URL('https://api.open-meteo.com/v1/forecast')
      url.search = new URLSearchParams({
        latitude: String(lat),
        longitude: String(lon),
        current: 'temperature_2m,weather_code',
        timezone: 'auto',
      }).toString()

      const res = await fetch(url)
      if (!res.ok) return null
      const data = await res.json()
      return {
        temp: Math.round(data.current.temperature_2m),
        icon: weatherIcon(data.current.weather_code),
      }
    } catch {
      return null
    }
  }

  function updateLiveTime() {
    document.querySelectorAll<HTMLElement>('.live-time-widget').forEach((el) => {
      const timezone = el.getAttribute('data-timezone') || 'UTC'
      el.textContent = new Date().toLocaleTimeString('en-US', {
        timeZone: timezone,
        hour12: true,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      })
    })
  }

  async function initWeather() {
    document.querySelectorAll<HTMLElement>('.lw-weather-icon').forEach(async (iconEl) => {
      const lat = parseFloat(iconEl.dataset.lat ?? '')
      const lon = parseFloat(iconEl.dataset.lon ?? '')
      if (isNaN(lat) || isNaN(lon)) return

      const weather = await fetchWeather(lat, lon)
      const tempEl = iconEl.nextElementSibling as HTMLElement | null

      if (!weather) {
        tempEl?.classList.remove('lw-loading')
        return
      }

      iconEl.className = `${weather.icon} op-70 shrink-0 text-sm`

      if (tempEl?.classList.contains('lw-weather-temp')) {
        tempEl.textContent = `${weather.temp}°`
        tempEl.classList.remove('lw-loading')
      }
    })
  }

  let intervalId: ReturnType<typeof setInterval> | undefined

  document.addEventListener('astro:page-load', () => {
    updateLiveTime()
    if (intervalId) clearInterval(intervalId)
    intervalId = setInterval(updateLiveTime, 1000)
    initWeather()
  })
</script>
