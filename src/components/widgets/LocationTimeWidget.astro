---
import PillWidget from './PillWidget.astro'
import { PILL_WIDGET_ICON_CLASSES } from './pillIcons'
import { FEATURES } from '~/config'

interface Props {
  location?: string
  timezone?: string
  lat?: number
  lon?: number
}

const { location: locationFeature } = FEATURES
const enabled = Array.isArray(locationFeature) && locationFeature[0]
const featureConfig = enabled ? locationFeature[1] : null

const {
  location = featureConfig?.label ?? 'Unknown',
  timezone = featureConfig?.timezone ?? 'UTC',
  lat = featureConfig?.lat,
  lon = featureConfig?.lon,
} = Astro.props

const LOCATION_ICON_CLASS = PILL_WIDGET_ICON_CLASSES.location
const TIME_ICON_CLASS = PILL_WIDGET_ICON_CLASSES.time

const showWeather = lat !== undefined && lon !== undefined
const mapsUrl = 'https://maps.app.goo.gl/2rykg2HR5Mb4gmzF9'
const weatherUrl = `https://wttr.in/${encodeURIComponent(location)}`
---

<PillWidget class="text-sm font-medium">
  <div class={LOCATION_ICON_CLASS}></div>
  <a
    href={mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="pill-primary text-xs">{location}</a
  >

  {
    showWeather && (
      <>
        <span class="op-20 select-none text-[10px] mx-0.5">|</span>
        {/* pill-widget-link: hovering the anchor tints only the pill-primary temp, not the icon */}
        <a
          href={weatherUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="pill-widget-link inline-flex items-center gap-1"
        >
          <span
            class="lw-weather-icon shrink-0"
            data-lat={lat}
            data-lon={lon}
          />
          <span class="lw-weather-temp pill-primary font-mono text-xs tabular-nums pill-loading">
            --°
          </span>
        </a>
      </>
    )
  }

  <span class="op-20 select-none text-[10px] mx-0.5">|</span>

  <div class={TIME_ICON_CLASS}></div>
  <span
    class="font-mono text-emerald-600 dark:text-emerald-400 text-xs live-time-widget tracking-tight tabular-nums"
    data-timezone={timezone}
  >
    --:--:-- --
  </span>
</PillWidget>

<style>
  /* Location link and weather temp use the shared `.pill-primary` color/hover
     from PillWidget. Only JS hooks and presentation that PillWidget doesn't
     own live here. */
  .lw-weather-icon-sized {
    width: 1.75rem !important;
    height: 1.75rem !important;
  }
</style>

<script>
  import { weatherIcon } from '~/utils/weather'

  async function fetchWeather(lat: number, lon: number) {
    try {
      const url = new URL('https://api.open-meteo.com/v1/forecast')
      url.search = new URLSearchParams({
        latitude: String(lat),
        longitude: String(lon),
        current: 'temperature_2m,weather_code,is_day',
        timezone: 'auto',
      }).toString()

      const res = await fetch(url)
      if (!res.ok) return null
      const data = await res.json()
      return {
        temp: Math.round(data.current.temperature_2m),
        icon: weatherIcon(data.current.weather_code, data.current.is_day === 1),
      }
    } catch {
      return null
    }
  }

  function updateLiveTime() {
    document
      .querySelectorAll<HTMLElement>('.live-time-widget')
      .forEach((el) => {
        const timezone = el.getAttribute('data-timezone') || 'UTC'
        el.textContent = new Date().toLocaleTimeString('en-US', {
          timeZone: timezone,
          hour12: true,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
        })
      })
  }

  async function initWeather() {
    document
      .querySelectorAll<HTMLElement>('.lw-weather-icon')
      .forEach(async (iconEl) => {
        const lat = parseFloat(iconEl.dataset.lat ?? '')
        const lon = parseFloat(iconEl.dataset.lon ?? '')
        if (isNaN(lat) || isNaN(lon)) return

        const weather = await fetchWeather(lat, lon)
        const tempEl = iconEl.nextElementSibling as HTMLElement | null

        if (!weather) {
          tempEl?.classList.remove('pill-loading')
          return
        }

        iconEl.className = `${weather.icon} shrink-0 lw-weather-icon-sized`

        if (tempEl?.classList.contains('lw-weather-temp')) {
          tempEl.textContent = `${weather.temp}°`
          tempEl.classList.remove('pill-loading')
        }
      })
  }

  let intervalId: ReturnType<typeof setInterval> | undefined

  document.addEventListener('astro:page-load', () => {
    updateLiveTime()
    if (intervalId) clearInterval(intervalId)
    intervalId = setInterval(updateLiveTime, 1000)
    initWeather()
  })
</script>
