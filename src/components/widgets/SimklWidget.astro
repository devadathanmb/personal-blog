---
import PillWidget from './PillWidget.astro'
import { PILL_WIDGET_ICON_CLASSES } from './pillIcons'
import { FEATURES } from '~/config'

const { simkl } = FEATURES
const enabled = Array.isArray(simkl) && simkl[0]
const { profileUrl = '' } = enabled ? simkl[1] : {}
const ICON_CLASS = PILL_WIDGET_ICON_CLASSES.simkl
---

{
  enabled && profileUrl && (
    <PillWidget class="simkl-widget">
      <div slot="icon" class={ICON_CLASS} />
      <a
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="pill-widget-link flex flex-col justify-center max-w-[200px] sm:max-w-[250px]"
      >
        <span
          id="simkl-title"
          class="pill-primary text-xs font-medium leading-tight pill-loading truncate"
        >
          Loading...
        </span>
        <span
          id="simkl-meta"
          class="pill-secondary text-[11px] leading-tight pill-loading truncate"
        >
          SIMKL
        </span>
      </a>
    </PillWidget>
  )
}

<script>
  import { fetchWatching } from '~/utils/simkl'
  import { getRelativeTime } from '~/utils/datetime'
  let pollTimer: ReturnType<typeof setInterval> | undefined
  let loading = false

  async function initSimklWidget() {
    const widget = document.querySelector<HTMLElement>('.simkl-widget')
    if (!widget || loading || document.hidden) return
    loading = true

    const titleEl = widget.querySelector<HTMLElement>('#simkl-title')
    const metaEl = widget.querySelector<HTMLElement>('#simkl-meta')
    const result = await fetchWatching()
    loading = false
    if (!widget.isConnected) return
    if (titleEl) {
      titleEl.textContent =
        result.status === 'watched' ||
        result.status === 'playing' ||
        result.status === 'paused'
          ? result.item.title
          : 'SIMKL'
      titleEl.classList.remove('pill-loading')
    }
    if (metaEl) {
      if (result.status === 'playing' || result.status === 'paused') {
        const state = result.status === 'playing' ? 'Watching now' : 'Paused'
        const progress =
          result.item.progress === null ? '' : ` • ${result.item.progress}%`
        metaEl.textContent = `${state}${result.item.subtitle ? ` • ${result.item.subtitle}` : ''}${progress}`
      } else if (result.status === 'watched') {
        const time = `Watched ${getRelativeTime(result.item.watchedAt)}`
        metaEl.textContent = result.item.subtitle
          ? `SIMKL • ${result.item.subtitle} • ${time}`
          : `SIMKL • ${time}`
      } else {
        metaEl.textContent =
          result.status === 'empty' ? 'No watches yet' : 'History unavailable'
      }
      metaEl.classList.remove('pill-loading')
    }
  }

  document.addEventListener('astro:page-load', () => {
    clearInterval(pollTimer)
    initSimklWidget()
    if (document.querySelector('.simkl-widget'))
      pollTimer = setInterval(initSimklWidget, 15_000)
  })
  document.addEventListener('astro:before-swap', () => clearInterval(pollTimer))
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) initSimklWidget()
  })
</script>
