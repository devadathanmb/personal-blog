---
interface UsesItem {
  name: string
  url: string
  icon: string
  btnClass: string
  title: string
}

interface UsesCategory {
  label: string
  items: UsesItem[]
}

interface Props {
  section: {
    title: string
    categories: UsesCategory[]
  }
}

const { section } = Astro.props

const getColor = (btnClass: string) => btnClass.replace('btn-', '')
const id = section.title
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')
---

<h2 {id}>
  <a class="header-anchor" href={`#${id}`}>#</a>
  {section.title}
</h2>

<div class="flex flex-col mb-10">
  {
    section.categories.map((category) => (
      <div class="mt-6 first:mt-3">
        <div class="text-sm tracking-wider uppercase font-mono op-45 mb-3">
          {category.label}
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          {category.items.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`card-${getColor(item.btnClass)}`}
            >
              <div class={`${item.icon} text-2xl mt-1 shrink-0 op-60`} />
              <div class="flex flex-col min-w-0">
                <span class="text-sm font-medium leading-snug">
                  {item.name}
                </span>
                <span class="text-xs op-50 leading-snug mt-1">
                  {item.title}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))
  }
</div>
