---
import Link from '~/components/base/Link.astro'
import { withBasePath } from '~/utils/path'
import { SITE } from '~/config'
---

<Link
  class="select-none op-transition"
  href={withBasePath('/')}
  aria-label={SITE.author}
  aria-current={Astro.url.pathname === `${withBasePath('/')}` ? 'page' : false}
>
  <!--
    SVG logo: Dancing Script Bold "Dev" glyph extracted as a path.

    Only the filled glyph lives in the markup. The handwriting animation
    (script below) builds one stroked path per letter from hand-authored
    pen centerlines and animates their stroke-dasharray to simulate a pen
    writing and un-writing each letter along its real trajectory.
  -->
  <svg
    class="logo-svg"
    viewBox="0 0 160 101"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Filled glyph: static fallback for prefers-reduced-motion only -->
    <path
      class="logo-fill"
      transform="translate(3,82)"
      fill="currentColor"
      stroke="none"
      opacity="0"
      d="M19.10 8.70Q15.60 8.70 12.45 7.75Q9.30 6.80 7 3.70Q7.30 1.30 8.45-3.30Q9.60-7.90 11.30-13.75Q13-19.60 14.90-25.80Q16.80-32 18.65-37.65Q20.50-43.30 21.95-47.55Q23.40-51.80 24.10-53.70Q24.40-54.50 25.10-56.10Q25.80-57.70 26.90-59.40Q28-61.10 29.45-62.25Q30.90-63.40 32.60-63.40Q34.30-63.40 36.40-62Q33.30-55 30.15-46.45Q27-37.90 24.15-28.85Q21.30-19.80 18.95-11.25Q16.60-2.70 15.10 4.40Q15.90 4.70 17.35 4.85Q18.80 5 20.10 5Q26.60 5 32.50 1.85Q38.40-1.30 43.35-6.55Q48.30-11.80 52-18.35Q55.70-24.90 57.70-31.80Q59.70-38.70 59.70-45Q59.70-53.10 56.95-58.15Q54.20-63.20 49.40-65.55Q44.60-67.90 38.40-67.90Q31.90-67.90 26.70-65.55Q21.50-63.20 18.55-59.15Q15.60-55.10 15.60-49.90Q15.60-48.80 15.80-47.55Q16-46.30 16.50-45.10Q12.20-45.10 10.35-46.95Q8.50-48.80 8.50-51.50Q8.50-55 11.05-58.60Q13.60-62.20 18.15-65.25Q22.70-68.30 28.70-70.15Q34.70-72 41.70-72Q51.50-72 57.40-68.25Q63.30-64.50 65.95-58.15Q68.60-51.80 68.60-44Q68.60-35.40 65.85-27.55Q63.10-19.70 58.25-13.10Q53.40-6.50 47.05-1.60Q40.70 3.30 33.55 6Q26.40 8.70 19.10 8.70M79.40 4.40Q73 4.40 69.55 0.95Q66.10-2.50 66.10-7.70Q66.10-12.10 68.35-17.05Q70.60-22 74.40-26.35Q78.20-30.70 82.80-33.40Q87.40-36.10 92-36.10Q94.60-36.10 96.95-34.75Q99.30-33.40 99.30-29.40Q99.30-25.60 97.10-22.30Q94.90-19 91.20-16.40Q87.50-13.80 83.05-12.15Q78.60-10.50 74.10-10Q74-9.60 73.95-9.15Q73.90-8.70 73.90-7.70Q73.90-7.20 74.05-5.95Q74.20-4.70 74.90-3.30Q75.60-1.90 77.20-0.90Q78.80 0.10 81.60 0.10Q85.80 0.10 90.05-2.25Q94.30-4.60 98.05-8.50Q101.80-12.40 104.30-17.20L106.30-15.60Q103.60-9.60 99.35-5.10Q95.10-0.60 89.95 1.90Q84.80 4.40 79.40 4.40M75.20-13.70Q77.80-14 81-15.50Q84.20-17 87.15-19.30Q90.10-21.60 92-24.35Q93.90-27.10 93.90-29.90Q93.90-31 93.50-31.40Q93.10-31.80 92.20-31.80Q89.90-31.80 87.40-30.15Q84.90-28.50 82.50-25.85Q80.10-23.20 78.20-20Q76.30-16.80 75.20-13.70M109.30 3.90Q105.60 3.90 104.15 0.55Q102.70-2.80 102.70-8.10Q102.70-9.20 102.80-12.05Q102.90-14.90 103.10-20Q103.20-23 103.75-24.10Q104.30-25.20 106.90-25.20Q109.30-25.20 109.75-24.25Q110.20-23.30 110.20-20.40Q110.20-17.40 109.95-14Q109.70-10.60 109.70-7.40Q109.70-4.30 110-2.85Q110.30-1.40 111.50-1.40Q113.30-1.40 115.40-3.35Q117.50-5.30 119.65-8.35Q121.80-11.40 123.75-14.95Q125.70-18.50 127.20-21.80Q127.40-28.60 128.80-30.90Q130.20-33.20 132.40-33.20Q134.90-33.20 135.80-31.60Q136.70-30 136.70-28.80Q136.70-27.30 135.90-26.10Q135.10-24.90 134.30-22.80Q133.50-20.70 133.50-16.40Q133.50-15 133.75-13.35Q134-11.70 134.95-10.55Q135.90-9.40 137.80-9.40Q139.80-9.40 141.65-11.05Q143.50-12.70 145.60-16.80L146.70-15.90Q144.40-10.40 141.55-8.20Q138.70-6 136.10-6Q132.80-6 130.75-8.65Q128.70-11.30 127.60-15.30Q125.20-10.80 122.15-6.40Q119.10-2 115.80 0.95Q112.50 3.90 109.30 3.90"
    ></path>
  </svg>
</Link>

<script>
  /**
   * Handwriting animation, driven by a single rAF tween per phase.
   *
   * Each letter is written as a separate pen stroke along a hand-authored
   * centerline (the pen's real trajectory through the glyph — D: stem, bowl,
   * curl in one motion; e: eye loop, exit; v: arm, rise, top loop, tail),
   * not the glyph's outline contour, whose doubled-back edges made the D
   * read as a hollow sketch. Duration is proportional to the stroke's real
   * length (constant pen speed), a gentle in/out ease per stroke, and a
   * short pen lift between letters. A small "nib" dot rides the
   * stroke tip via getPointAtLength — it must share the exact eased progress
   * value with the dash animation, which is why this uses rAF instead of
   * WAAPI/CSS (their eased output can't be read back per frame).
   *
   * Cycle: write (per stroke, ~4s) → brightness rises → hold → back to
   * base → un-write in reverse stroke order → blank pause → repeat.
   * The logo stays as the handwritten line signature throughout; the
   * filled glyph is only shown statically for prefers-reduced-motion.
   */
  let cancelLogoLoop: (() => void) | undefined

  const SVG_NS = 'http://www.w3.org/2000/svg'
  const WRITE_MS = 3400 // total pen-on-paper time, shared across strokes
  const ERASE_MS = 1900
  const LIFT_MS_PER_UNIT = 3.5 // pen travel between letters scales with distance
  const PEN_OPACITY = 0.95

  // Pen centerlines, in the glyph's coordinate space (translate(3,82)).
  const PEN_STROKES = [
    'M 34 -61 C 29 -50 22 -32 16 -14 C 13 -5 10 2 10 5 C 10 7.5 15 7 20 6.5 C 33 4.5 45 -3 52 -13 C 58 -21 64 -33 64 -44 C 64 -55 55 -66 44 -69.5 C 33 -72 21 -66 15 -58 C 11 -53 10 -49 12.5 -47.2 C 13.2 -46.7 13.8 -46.4 14.5 -46.6',
    'M 74.5 -11.5 C 82 -14 92 -20 95.5 -27.5 C 97.5 -32 93 -35.5 87 -32.5 C 80 -29 72 -20 70.5 -12 C 69 -4 73 2 81 1.5 C 89 1 99 -6 105.5 -16',
    'M 108 -24.5 C 105.5 -17 104.5 -6 108 -0.5 C 110 2.5 114 0 117.5 -4.5 C 122 -10 126 -17 128.5 -24 C 130 -29 132.5 -33 134.5 -31 C 136 -29 133 -19 132 -13.5 C 131.5 -9.5 133.5 -6.5 137.5 -7.5 C 141 -8.5 144.5 -12 146.3 -16.3',
  ]

  function initLogo() {
    cancelLogoLoop?.()

    // Re-assigned to fresh consts so TS keeps the non-null narrowing
    // inside the async closures below.
    const fillEl = document.querySelector<SVGPathElement>('.logo-fill')
    const svgEl = fillEl?.closest<SVGSVGElement>('svg')
    if (!fillEl || !svgEl) return
    const fillPath = fillEl
    const svg = svgEl

    let alive = true
    cancelLogoLoop = () => {
      alive = false
      cancelLogoLoop = undefined
    }

    // Reset any state a previous run left behind (the nav can persist
    // across astro:page-load, so a re-init must start from a clean slate).
    fillPath.style.opacity = '0'
    svg.style.filter = ''
    svg.querySelector('.logo-strokes')?.remove()

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      fillPath.style.opacity = '1'
      return
    }

    // ── Build one stroke path per letter from its pen centerline ──────────
    const group = document.createElementNS(SVG_NS, 'g')
    group.setAttribute('class', 'logo-strokes')

    const strokes = PEN_STROKES.map((d) => {
      const p = document.createElementNS(SVG_NS, 'path')
      p.setAttribute('d', d)
      p.setAttribute('transform', 'translate(3,82)') // same space as the glyph
      p.setAttribute('fill', 'none')
      p.setAttribute('stroke', 'currentColor')
      p.setAttribute('stroke-width', '5')
      p.setAttribute('stroke-linecap', 'round')
      p.setAttribute('stroke-linejoin', 'round')
      p.style.visibility = 'hidden'
      group.appendChild(p)
      return p
    })

    const pen = document.createElementNS(SVG_NS, 'circle')
    pen.setAttribute('r', '4.5')
    pen.setAttribute('fill', 'currentColor')
    pen.setAttribute('transform', 'translate(3,82)')
    pen.style.opacity = '0'
    group.appendChild(pen)

    svg.appendChild(group)

    const lengths = strokes.map((s) => s.getTotalLength())
    const totalLen = lengths.reduce((a, b) => a + b, 0)
    strokes.forEach((s, i) => (s.style.strokeDasharray = `0 ${lengths[i]}`))

    const easeInOutSine = (t: number) => -(Math.cos(Math.PI * t) - 1) / 2

    const sleep = (ms: number) =>
      new Promise<void>((resolve) => setTimeout(resolve, ms))

    /** Runs onFrame with eased progress 0→1 over `duration` ms. */
    const tween = (duration: number, onFrame: (p: number) => void) =>
      new Promise<void>((resolve) => {
        const t0 = performance.now()
        const frame = (now: number) => {
          if (!alive) return resolve()
          const t = Math.min((now - t0) / duration, 1)
          onFrame(easeInOutSine(t))
          if (t < 1) requestAnimationFrame(frame)
          else resolve()
        }
        requestAnimationFrame(frame)
      })

    const movePen = (x: number, y: number) => {
      pen.setAttribute('cx', String(x))
      pen.setAttribute('cy', String(y))
    }

    async function drawStroke(i: number) {
      const path = strokes[i]!
      const L = lengths[i]!
      // Constant pen speed: share WRITE_MS by length, with a little human
      // variance so no two loops are identical.
      const duration =
        Math.max(320, (L / totalLen) * WRITE_MS) * (0.94 + Math.random() * 0.12)
      path.style.visibility = 'visible'
      await tween(duration, (p) => {
        const at = p * L
        path.style.strokeDasharray = `${at} ${L}`
        const pt = path.getPointAtLength(at)
        movePen(pt.x, pt.y)
      })
    }

    /** Pen hops from the end of one stroke to the start of the next: it
     *  rises off the paper (fades, arcs up) and lands at the new point.
     *  Travel time scales with the hop distance, so the long D→e hop
     *  takes visibly longer than the short e→v one. */
    async function penLift(from: number, to: number) {
      const a = strokes[from]!.getPointAtLength(lengths[from]!)
      const b = strokes[to]!.getPointAtLength(0)
      const dist = Math.hypot(b.x - a.x, b.y - a.y)
      const duration = Math.min(280, Math.max(110, dist * LIFT_MS_PER_UNIT))
      await tween(duration, (p) => {
        const hover = Math.sin(p * Math.PI)
        movePen(a.x + (b.x - a.x) * p, a.y + (b.y - a.y) * p - hover * 5)
        pen.style.opacity = String(PEN_OPACITY - hover * 0.65)
      })
      pen.style.opacity = String(PEN_OPACITY)
    }

    async function eraseStroke(i: number) {
      const path = strokes[i]!
      const L = lengths[i]!
      const duration = Math.max(150, (L / totalLen) * ERASE_MS)
      await tween(duration, (p) => {
        path.style.strokeDasharray = `${(1 - p) * L} ${L}`
      })
      // Round linecaps render a dot on a zero-length dash — hide fully.
      path.style.visibility = 'hidden'
    }

    async function runLoop() {
      await sleep(600) // brief pause before the first write

      while (alive) {
        // ── 1. Write: pen descends onto the paper, writes each letter,
        //      then flicks away ─────────────────────────────────────────────
        const start = strokes[0]!.getPointAtLength(0)
        await tween(220, (p) => {
          movePen(start.x - 7 * (1 - p), start.y - 11 * (1 - p)) // land in an arc
          pen.style.opacity = String(p * PEN_OPACITY)
        })
        for (let i = 0; i < strokes.length && alive; i++) {
          await drawStroke(i)
          if (alive && i < strokes.length - 1) await penLift(i, i + 1)
        }
        if (!alive) break
        const end = strokes.at(-1)!.getPointAtLength(lengths.at(-1)!)
        await tween(160, (p) => {
          movePen(end.x + p * 8, end.y - p * 7) // flick up and away
          pen.style.opacity = String(PEN_OPACITY * (1 - p))
        })
        if (!alive) break

        // ── 2. Brightness rises slowly once the word is written ───────────
        const isDark = document.documentElement.classList.contains('dark')
        const peak = isDark ? 1.6 : 0.5
        await tween(
          2000,
          (p) => (svg.style.filter = `brightness(${1 + (peak - 1) * p})`)
        )
        if (!alive) break

        // ── 3. Hold: fully written, at peak brightness ─────────────────────
        await sleep(2000)
        if (!alive) break

        // ── 4. Return to normal ────────────────────────────────────────────
        await tween(
          400,
          (p) => (svg.style.filter = `brightness(${peak + (1 - peak) * p})`)
        )
        if (!alive) break

        // ── 5. Un-write: strokes retreat in reverse writing order ──────────
        for (let i = strokes.length - 1; i >= 0 && alive; i--) {
          await eraseStroke(i)
          if (alive && i > 0) await sleep(60)
        }
        if (!alive) break

        // ── 6. Pause blank ─────────────────────────────────────────────────
        await sleep(1800)
      }
    }

    runLoop()
  }

  initLogo()
  document.addEventListener('astro:before-swap', () => cancelLogoLoop?.())
  document.addEventListener('astro:page-load', initLogo)
  // Re-init if the user toggles reduced motion mid-session.
  window
    .matchMedia('(prefers-reduced-motion: reduce)')
    .addEventListener('change', initLogo)
</script>

<style>
  .logo-svg {
    /* Same visual size as the original 1.85rem text logo */
    height: 2.15rem;
    width: auto;
    display: block;
    overflow: visible;
  }

  @media (max-width: 767.9px) {
    .logo-svg {
      height: 1.85rem;
    }
  }

  /* Hidden while the animation runs — the stroked signature is the logo.
     JS un-hides it only as the prefers-reduced-motion static fallback. */
  .logo-fill {
    opacity: 0;
  }
</style>
