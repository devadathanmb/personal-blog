---
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash, withBasePath } from '~/utils/path'

const currentPath = ensureTrailingSlash(Astro.url.pathname)
const postCollectionRoot = [
  withBasePath('/blog/'),
  withBasePath('/thoughts/'),
].find((root) => currentPath.startsWith(root) && currentPath !== root)
const pathSegments = currentPath.split('/').slice(0, -2)
const href =
  postCollectionRoot ??
  (pathSegments.length > 1 ? pathSegments.join('/') + '/' : withBasePath('/'))
---

<span class="font-mono op-50">&gt; </span>
<Link class="font-mono op-50!" {href}>cd ..</Link>
