---
interface Props {
  date: string
  label?: string
  freshDays?: number
  staleDays?: number
  pulse?: boolean
}

const {
  date,
  label = 'Last updated',
  freshDays = 31,
  staleDays = 180,
  pulse = true,
} = Astro.props

const then = new Date(date)
const days = Math.floor((Date.now() - then.getTime()) / 86_400_000)
const status =
  days <= freshDays ? 'fresh' : days <= staleDays ? 'aging' : 'stale'

const exactDate = then.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
})
---

<span
  class={`lu-widget lu-${status} inline-flex items-center whitespace-nowrap cursor-default w-fit`}
  title={`Updated ${exactDate}`}
  data-date={date}
>
  <span class="relative inline-flex flex-none lu-dot-wrap" aria-hidden="true">
    {pulse && <span class="lu-ping absolute inset-0 rounded-full" />}
    <span class="lu-dot relative rounded-full"></span>
  </span>
  <span class="lu-label font-normal">{label}</span>
  <span class="lu-rel font-mono font-medium" style="letter-spacing:0.03em;">
    <!-- filled by client script -->
  </span>
</span>

<style>
  /* ── Per-status color vars ────────────────────────────────── */
  .lu-fresh {
    --lu-color: #059669;
  }
  .lu-aging {
    --lu-color: #d97706;
  }
  .lu-stale {
    --lu-color: #dc2626;
  }

  :root.dark .lu-fresh {
    --lu-color: #34d399;
  }
  :root.dark .lu-aging {
    --lu-color: #fbbf24;
  }
  :root.dark .lu-stale {
    --lu-color: #f87171;
  }

  /* ── Container — rule annotation, no box ─────────────────── */
  .lu-widget {
    gap: 0.55rem;
    padding: 0.2rem 0;
    font-size: var(--text-sm, 0.875rem);
    line-height: 1.3;
  }

  /* ── Dot ──────────────────────────────────────────────────── */
  .lu-dot-wrap {
    width: 6px;
    height: 6px;
  }
  .lu-dot {
    width: 6px;
    height: 6px;
    background: var(--lu-color);
  }

  /* ── Label ────────────────────────────────────────────────── */
  .lu-label {
    color: var(--fg-light, #777);
    font-size: 0.75rem;
  }

  /* ── Relative time ────────────────────────────────────────── */
  .lu-rel {
    font-size: 0.74rem;
    color: var(--lu-color);
  }

  /* ── Ping animation ───────────────────────────────────────── */
  @keyframes lu-status-ping {
    0% {
      transform: scale(1);
      opacity: 0.65;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .lu-ping {
    background: var(--lu-color);
    animation: lu-status-ping 1.9s ease-out infinite;
  }
</style>

<script>
  const DAY = 86_400_000

  function relativeTime(thenMs: number, nowMs: number): string {
    const diff = Math.max(0, nowMs - thenMs)
    const days = Math.floor(diff / DAY)
    if (days <= 0) return 'today'
    if (days === 1) return 'yesterday'
    if (days < 7) return `${days} days ago`
    if (days < 31) {
      const w = Math.round(days / 7)
      return `${w} week${w > 1 ? 's' : ''} ago`
    }
    if (days < 365) {
      const m = Math.round(days / 30)
      return `${m} month${m > 1 ? 's' : ''} ago`
    }
    const y = Math.floor(days / 365)
    return `${y} year${y > 1 ? 's' : ''} ago`
  }

  function updateWidgets() {
    document.querySelectorAll<HTMLElement>('.lu-widget').forEach((el) => {
      const date = el.dataset.date
      if (!date) return
      const rel = el.querySelector<HTMLElement>('.lu-rel')
      if (rel)
        rel.textContent = relativeTime(new Date(date).getTime(), Date.now())
    })
  }

  document.addEventListener('astro:page-load', updateWidgets)
</script>
