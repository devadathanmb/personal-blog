---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";

export interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex items-center justify-center gap-4"
      aria-label="Pagination"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={[
          "inline-flex items-center gap-1.5 rounded border border-border px-3 py-1.5 text-sm transition-colors select-none hover:border-accent hover:text-accent",
          { "opacity-40": !page.url.prev },
        ]}
        ariaLabel="Previous"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        Prev
      </LinkButton>

      <span class="text-sm">
        <span class="font-semibold text-accent">{page.currentPage}</span>
        <span class="mx-1 opacity-40">/</span>
        <span class="opacity-60">{page.lastPage}</span>
      </span>

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={[
          "inline-flex items-center gap-1.5 rounded border border-border px-3 py-1.5 text-sm transition-colors select-none hover:border-accent hover:text-accent",
          { "opacity-40": !page.url.next },
        ]}
        ariaLabel="Next"
      >
        Next
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
