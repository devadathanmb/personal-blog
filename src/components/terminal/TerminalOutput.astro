---
// TerminalOutput component - renders command output
---

<div class="terminal-output">
  <slot />
</div>

<style>
  .terminal-output {
    color: var(--color-terminal-text);
    margin-left: 1.5rem;
    margin-bottom: 0.5rem;
    word-wrap: break-word;
  }

  /* Mobile responsive */
  @media (max-width: 768px) {
    .terminal-output {
      margin-left: 0.75rem;
      margin-bottom: 0.25rem;
    }
  }

  @media (max-width: 480px) {
    .terminal-output {
      margin-left: 0.5rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
