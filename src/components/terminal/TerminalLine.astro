---
// TerminalLine component - renders a terminal prompt line
// Content after the prompt is passed via default slot
const { class: className, ...rest } = Astro.props;
const classes = className ? `terminal-line ${className}` : "terminal-line";
---

<div class={classes} {...rest}>
  <span class="username">Dev</span><span class="at-symbol">@</span><span
    class="hostname">Machine</span
  ><span class="path">:~</span><span class="prompt">$</span>
  <slot />
</div>

<style>
  .terminal-line {
    margin-top: 1rem;
    margin-bottom: 0.25rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .terminal-line:first-child {
    margin-top: 0;
  }

  .username {
    color: var(--color-accent);
    margin-right: 0;
  }

  .at-symbol {
    color: var(--color-terminal-text);
    margin: 0;
  }

  .hostname {
    color: var(--color-terminal-green);
    margin: 0;
  }

  .path {
    color: var(--color-accent);
    margin-right: 0.25rem;
  }

  .prompt {
    color: var(--color-accent);
    margin-right: 0.25rem;
  }

  /* Mobile responsive styles - hide verbose prompt parts, show only $ */
  @media (max-width: 768px) {
    .terminal-line {
      margin-top: 0.75rem;
      margin-bottom: 0.125rem;
    }

    .username,
    .at-symbol,
    .hostname,
    .path {
      display: none;
    }

    .prompt {
      margin-right: 0.5ch;
    }
  }
</style>
