---
import { SOCIALS } from "@/constants";
import { SITE } from "@/config";
import TerminalLine from "./TerminalLine.astro";
import TerminalOutput from "./TerminalOutput.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

// Extract domain from SITE.website (removes https://)
const domain = SITE.website.replace(/^https?:\/\//, "");

// Fun tooltips for social links
const SOCIAL_TOOLTIPS: Record<string, string> = {
  GitHub: "Where the code lives... and sometimes dies",
  LinkedIn: "Professional me (I swear I'm serious)",
  Mail: "Slide into my inbox!",
  Discord: "Let's chat and procrastinate together",
  Telegram: "For when email is too mainstream",
};

const TERMINAL_MESSAGES = [
  "# You're awesome :)",
  "# Welcome to the void... I mean, my blog!",
  "# Making bugs since 2002... wait, features!",
  "# Hey! You found me on the internet!",
  `# ${new Date().getFullYear()} is the year of the Linux Desktop!`,
  "rm -fr / --no-preserve-root # For removing French",
  "# There's no place like 127.0.0.1",
  "sudo rm -rf /problems # if it was that easy",
  "# Have you tried turning it off and on again?",
  "git commit -m 'fix bug' # lies",
  "# Works on my machine ¯\\_(ツ)_/¯",
  "npm install happiness # still waiting...",
  "# TODO: figure life out",
  "git checkout -b coping",
  "sudo systemctl restart motivation.service",
  "cat /dev/null > expectations",
  "make clean && make mistakes",
  "ps aux | grep purpose",
  "# There are 10 types of people: those who understand binary",
  "git blame # always someone else's fault",
  "# 99 little bugs in the code, 99 bugs in the code...",
  "chmod 777 # what could go wrong?",
  "exit 1 # try again tomorrow",
];
---

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-buttons">
      <span class="btn btn-close" title="Nice try! I'm immortal"></span>
      <span class="btn btn-minimize" title="Minimizing existential dread..."
      ></span>
      <span class="btn btn-maximize" title="Already at max awesomeness"></span>
    </div>
    <div class="terminal-title">Dev@Machine:~$</div>
  </div>
  <div class="terminal-body">
    <TerminalLine><span class="valid-command">whoami</span></TerminalLine>
    <TerminalOutput>
      Devadathan <span class="aka-text">(Known among most as Dev)</span>
    </TerminalOutput>

    <TerminalLine
      ><span class="valid-command">echo</span>
      <span class="argument">$STATUS</span></TerminalLine
    >
    <TerminalOutput> Software engineer | Still figuring it out </TerminalOutput>

    <TerminalLine
      ><span class="valid-command">file</span>
      <span class="argument">about.txt</span></TerminalLine
    >
    <TerminalOutput>
      about.txt:
      <IconArrowRight class="arrow" />
      <span class="url-container">
        <a
          href="/about"
          class="symlink-path"
          title="So you wanna know about me ah?"
          data-url={`${SITE.website}/about`}
        >
          <span class="url-full">[{domain}/about]</span>
          <span class="url-short">[/about]</span>
        </a>
        <button class="copy-btn" data-copy-url={`${SITE.website}/about`}>
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
            ></path>
          </svg>
        </button>
      </span>
    </TerminalOutput>

    <TerminalLine
      ><span class="valid-command">git</span>
      <span class="argument">remote -v</span></TerminalLine
    >
    <TerminalOutput>
      <div class="git-remotes">
        {
          SOCIALS.map(social => {
            const slug =
              social.name.toLowerCase() === "mail"
                ? "email"
                : social.name.toLowerCase();
            return (
              <div class="remote-line">
                <span class="remote-name">{social.name}</span>
                <IconArrowRight class="arrow" />
                <span class="url-container">
                  <a
                    href={`/socials/${slug}`}
                    class="remote-url"
                    title={
                      SOCIAL_TOOLTIPS[social.name] || "Check out my profile"
                    }
                    data-url={`${SITE.website}/socials/${slug}`}
                  >
                    <span class="url-full">
                      [{domain}/socials/{slug}]
                    </span>
                    <span class="url-short">[/socials/{slug}]</span>
                  </a>
                  <button
                    class="copy-btn"
                    data-copy-url={`${SITE.website}/socials/${slug}`}
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                </span>
              </div>
            );
          })
        }
      </div>
    </TerminalOutput>

    <TerminalLine>
      <span class="typing-container">
        <span
          class="typed-text"
          data-messages={JSON.stringify(TERMINAL_MESSAGES)}></span>
        <span class="cursor-blink">_</span>
      </span>
    </TerminalLine>
  </div>
</div>

<style>
  .terminal-container {
    background-color: #1a1e23;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    max-width: 60rem;
    width: 100%;
    margin: 2rem auto 0 auto;
    font-family: inherit;
    overflow: hidden;
  }

  .terminal-header {
    background-color: #21262d;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-buttons {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
  }

  .btn:hover {
    transform: scale(1.15);
    filter: brightness(1.2);
  }

  .btn:active {
    transform: scale(0.95);
  }

  .btn-close {
    background-color: #ff5f56;
  }

  .btn-close:hover {
    box-shadow: 0 0 8px rgba(255, 95, 86, 0.6);
  }

  .btn-minimize {
    background-color: #ffbd2e;
  }

  .btn-minimize:hover {
    box-shadow: 0 0 8px rgba(255, 189, 46, 0.6);
  }

  .btn-maximize {
    background-color: #27ca3f;
  }

  .btn-maximize:hover {
    box-shadow: 0 0 8px rgba(39, 202, 63, 0.6);
  }

  .terminal-title {
    color: #f0f6fc;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .terminal-body {
    padding: 1rem;
    line-height: 1.625;
    min-height: 300px;
    overflow-x: auto;
  }

  .valid-command {
    color: var(--color-terminal-green);
    font-weight: 400;
  }

  .argument {
    color: #e6edf3;
    margin-left: 0.25rem;
  }

  .aka-text {
    font-style: italic;
  }

  .url-container {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    position: relative;
  }

  .copy-btn {
    opacity: 0;
    background: none;
    border: none;
    color: #8b949e;
    cursor: pointer;
    padding: 0.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    border-radius: 4px;
  }

  .url-container:hover .copy-btn {
    opacity: 1;
  }

  .copy-btn:hover {
    color: var(--color-terminal-green);
    background-color: rgba(139, 148, 158, 0.1);
  }

  .copy-btn:active {
    transform: scale(0.95);
  }

  .copy-btn.copied {
    color: var(--color-terminal-green);
  }

  .symlink-path {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .symlink-path:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  .remote-line {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.25rem;
    align-items: center;
  }

  .remote-name {
    color: #f0f6fc;
    font-weight: 400;
    min-width: 5.5rem;
    flex-shrink: 0;
  }

  .arrow {
    color: #c9d1d9;
    flex-shrink: 0;
    display: inline-block;
    vertical-align: middle;
    margin: 0 0.25rem;
    width: 1rem;
    height: 1rem;
  }

  .remote-url {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .remote-url:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  .url-short {
    display: none;
  }

  .url-full {
    display: inline;
  }

  .typing-container {
    display: inline-block;
    margin-left: 0.25rem;
    max-width: calc(100% - 2rem);
  }

  .typed-text {
    min-width: 1ch;
    display: inline;
  }

  .typed-text :global(.cmd) {
    color: var(--color-terminal-green);
  }

  .typed-text :global(.args) {
    color: #e6edf3;
  }

  .typed-text :global(.comment) {
    color: #8b949e;
  }

  .cursor-blink {
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  /* Light mode adjustments */
  html[data-theme="light"] .terminal-container {
    background-color: #f8f9fa;
    border-color: var(--color-border);
  }

  html[data-theme="light"] .terminal-header {
    background-color: #e9ecef;
    border-bottom-color: var(--color-border);
  }

  html[data-theme="light"] .terminal-title {
    color: #1f2328;
  }

  html[data-theme="light"] .valid-command {
    color: var(--color-terminal-green);
    font-weight: 400;
  }

  html[data-theme="light"] .argument {
    color: #24292f;
  }

  html[data-theme="light"] .symlink-path {
    color: var(--color-accent);
    font-weight: 500;
  }

  html[data-theme="light"] .symlink-path:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  html[data-theme="light"] .remote-name {
    color: #24292f;
  }

  html[data-theme="light"] .arrow {
    color: #424a53;
  }

  html[data-theme="light"] .copy-btn {
    color: #656d76;
  }

  html[data-theme="light"] .copy-btn:hover {
    color: var(--color-terminal-green);
    background-color: rgba(101, 109, 118, 0.1);
  }

  html[data-theme="light"] .remote-url {
    color: var(--color-accent);
  }

  html[data-theme="light"] .remote-url:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  html[data-theme="light"] .typed-text :global(.cmd) {
    color: var(--color-terminal-green);
  }

  html[data-theme="light"] .typed-text :global(.args) {
    color: #24292f;
  }

  html[data-theme="light"] .typed-text :global(.comment) {
    color: #656d76;
  }

  /* Mobile responsive styles */
  @media (max-width: 768px) {
    .terminal-container {
      margin: 1rem auto 0 auto;
      border-radius: 6px;
      max-width: none;
    }

    .terminal-header {
      padding: 0.5rem 0.75rem;
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
    }

    .terminal-title {
      font-size: 0.75rem;
    }

    .btn {
      width: 0.625rem;
      height: 0.625rem;
    }

    .terminal-body {
      padding: 1rem;
      min-height: 250px;
    }

    .remote-line {
      gap: 0.5rem;
    }

    .typing-container {
      margin-left: 0;
      display: inline;
    }

    .url-short {
      display: inline;
    }

    .url-full {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .terminal-container {
      margin: 0.5rem auto 0 auto;
    }

    .terminal-title {
      font-size: 0.7rem;
    }

    .terminal-body {
      padding: 0.75rem;
      min-height: 200px;
    }

    .remote-line {
      gap: 0.375rem;
    }

    .terminal-buttons {
      gap: 0.375rem;
    }

    .btn {
      width: 0.5rem;
      height: 0.5rem;
    }
  }
</style>

<script>
  function initTypingAnimation() {
    const typedTextElement = document.querySelector(".typed-text");
    if (!typedTextElement) return;

    const messages: string[] = JSON.parse(
      typedTextElement.getAttribute("data-messages") || "[]"
    );
    if (messages.length === 0) return;

    // Start with a random message for variety
    let messageIndex = Math.floor(Math.random() * messages.length);
    let charIndex = 0;
    let isDeleting = false;
    let isPaused = false;

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function parseAndColorize(text: string): string {
      if (!text) return "";

      // If starts with #, entire line is a comment
      if (text.trimStart().startsWith("#")) {
        return `<span class="comment">${escapeHtml(text)}</span>`;
      }

      // Split by # to separate command from inline comment
      const hashIndex = text.indexOf("#");
      let commandPart = text;
      let commentPart = "";

      if (hashIndex !== -1) {
        commandPart = text.substring(0, hashIndex);
        commentPart = text.substring(hashIndex);
      }

      // Split command part: first word is command, rest are args
      const trimmed = commandPart.trim();
      const firstSpaceIndex = trimmed.indexOf(" ");

      let result = "";

      if (firstSpaceIndex === -1) {
        // Only command, no args
        if (trimmed) {
          result += `<span class="cmd">${escapeHtml(trimmed)}</span>`;
        }
      } else {
        // Command with args
        const command = trimmed.substring(0, firstSpaceIndex);
        const args = trimmed.substring(firstSpaceIndex);

        result += `<span class="cmd">${escapeHtml(command)}</span>`;
        result += `<span class="args">${escapeHtml(args)}</span>`;
      }

      if (commentPart) {
        // Check if there's space before the comment in original text
        const spaceBeforeComment =
          commandPart.length > 0 &&
          commandPart.charAt(commandPart.length - 1) === " "
            ? " "
            : "";
        result += `<span class="comment">${spaceBeforeComment}${escapeHtml(commentPart)}</span>`;
      }

      return result;
    }

    function type() {
      if (!typedTextElement) return;

      const currentMessage = messages[messageIndex];

      if (isPaused) {
        setTimeout(type, 2000);
        isPaused = false;
        isDeleting = true;
        return;
      }

      if (isDeleting) {
        const displayText = currentMessage.substring(0, charIndex);
        typedTextElement.innerHTML = parseAndColorize(displayText);
        charIndex--;

        if (charIndex < 0) {
          isDeleting = false;
          messageIndex = (messageIndex + 1) % messages.length;
          charIndex = 0;
          setTimeout(type, 500);
          return;
        }
      } else {
        const displayText = currentMessage.substring(0, charIndex);
        typedTextElement.innerHTML = parseAndColorize(displayText);
        charIndex++;

        if (charIndex > currentMessage.length) {
          isPaused = true;
          setTimeout(type, 2000);
          return;
        }
      }

      const typingSpeed = isDeleting ? 30 : 80;
      setTimeout(type, typingSpeed);
    }

    // Start typing after a short delay
    setTimeout(type, 1000);
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", initTypingAnimation);

  // Copy to clipboard functionality
  function initCopyButtons() {
    const copyButtons = document.querySelectorAll(".copy-btn");

    copyButtons.forEach(button => {
      button.addEventListener("click", async e => {
        e.preventDefault();
        e.stopPropagation();

        const url = button.getAttribute("data-copy-url");
        if (!url) return;

        try {
          await navigator.clipboard.writeText(url);

          // Visual feedback
          button.classList.add("copied");
          const originalHTML = button.innerHTML;
          button.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          `;

          setTimeout(() => {
            button.classList.remove("copied");
            button.innerHTML = originalHTML;
          }, 1500);
        } catch {
          // Clipboard API failed - button won't show feedback
        }
      });
    });
  }

  document.addEventListener("astro:page-load", initCopyButtons);
</script>
