---
import { SOCIALS } from "@/constants";

const TERMINAL_MESSAGES = [
  "# You're awesome",
  "rm -rf / --no-preserve-root # change lang to French",
  "# There's no place like 127.0.0.1",
  "sudo rm -rf /problems # if only it were this easy",
  "# Have you tried turning it off and on again?",
  "git commit -m 'fix bug' # lies",
  "# Works on my machine ¯\\_(ツ)_/¯",
  "npm install happiness # still waiting...",
  "# TODO: figure life out",
  "git checkout -b coping",
  "sudo systemctl restart motivation.service # failed",
  "cat /dev/null > expectations",
  "make clean && make mistakes",
  "ps aux | grep purpose",
  "exit 1 # try again tomorrow",
];
---

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-buttons">
      <span class="btn btn-close"></span>
      <span class="btn btn-minimize"></span>
      <span class="btn btn-maximize"></span>
    </div>
    <div class="terminal-title">Dev@Machine:~$</div>
  </div>
  <div class="terminal-body">
    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Machine</span
      ><span class="path">:~$</span>
      <span class="valid-command">whoami</span>
    </div>
    <div class="terminal-output">
      Software Engineer | Backend | Still figuring it out
    </div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Machine</span
      ><span class="path">:~$</span>
      <span class="valid-command">file</span>
      <span class="argument">about.txt</span>
    </div>
    <div class="terminal-output">
      about.txt: symbolic link to <a href="/about" class="symlink-path">
        <span class="url-full">devadathanmb.in/about</span>
        <span class="url-short">/about</span>
      </a>
    </div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Machine</span
      ><span class="path">:~$</span>
      <span class="valid-command">git</span>
      <span class="argument">remote -v</span>
    </div>
    <div class="terminal-output git-remotes">
      {
        SOCIALS.map(social => {
          const slug =
            social.name.toLowerCase() === "mail"
              ? "email"
              : social.name.toLowerCase();
          return (
            <div class="remote-line">
              <span class="remote-name">{social.name}</span>
              <a href={`/socials/${slug}`} class="remote-url">
                <span class="url-full">devadathanmb.in/socials/{slug}</span>
                <span class="url-short">/socials/{slug}</span>
              </a>
            </div>
          );
        })
      }
    </div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Machine</span
      ><span class="path">:~$</span>
      <span class="typing-container">
        <span
          class="typed-text"
          data-messages={JSON.stringify(TERMINAL_MESSAGES)}></span>
        <span class="cursor-blink">_</span>
      </span>
    </div>
  </div>
</div>

<style>
  .terminal-container {
    background-color: #1a1e23;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    max-width: 60rem;
    width: 100%;
    margin: 2rem auto 0 auto;
    font-family: inherit;
    overflow: hidden;
  }

  .terminal-header {
    background-color: #21262d;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }

  .terminal-buttons {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .btn {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .btn-close {
    background-color: #ff5f56;
  }

  .btn-minimize {
    background-color: #ffbd2e;
  }

  .btn-maximize {
    background-color: #27ca3f;
  }

  .terminal-title {
    color: #f0f6fc;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .terminal-body {
    padding: 1rem;
    line-height: 1.625;
    min-height: 300px;
    overflow-x: auto;
  }

  .terminal-line {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .terminal-line:first-child {
    margin-top: 0;
  }

  .username {
    color: var(--color-accent);
    margin-right: 0;
  }

  .at-symbol {
    color: #e6edf3;
    margin: 0;
  }

  .hostname {
    color: var(--color-terminal-green);
    margin: 0;
  }

  .path {
    color: #58a6ff;
    margin-right: 0.25rem;
  }

  .command {
    color: #f0f6fc;
    word-break: break-all;
  }

  .valid-command {
    color: var(--color-terminal-green);
    font-weight: 400;
  }

  .command-flag {
    color: var(--color-terminal-green);
    margin-left: 0.25rem;
  }

  .argument {
    color: #e6edf3;
    margin-left: 0.25rem;
  }

  .terminal-output {
    color: #e6edf3;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
    word-wrap: break-word;
  }

  .file-permissions {
    color: #58a6ff;
    margin-right: 0.5rem;
    font-family: monospace;
  }

  .directory {
    color: #58a6ff;
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .directory:hover {
    color: #79c0ff;
    text-decoration: underline;
  }

  .symlink-path {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .symlink-path:hover {
    color: #79c0ff;
    text-decoration: underline;
  }

  .git-remotes {
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .remote-line {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .remote-name {
    color: #f0f6fc;
    font-weight: 400;
    min-width: 5.5rem;
    flex-shrink: 0;
  }

  .remote-url {
    color: var(--color-accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .remote-url:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  .url-short {
    display: none;
  }

  .url-full {
    display: inline;
  }

  .file-name {
    color: #e6edf3;
  }

  .typing-container {
    display: inline-block;
    margin-left: 0.25rem;
  }

  .typed-text {
    min-width: 1ch;
  }

  .typed-text :global(.cmd) {
    color: var(--color-terminal-green);
  }

  .typed-text :global(.args) {
    color: #e6edf3;
  }

  .typed-text :global(.comment) {
    color: #8b949e;
  }

  .cursor-blink {
    animation: blink 1s infinite;
  }

  .wave {
    display: inline-block;
    animation: wave 2.5s infinite;
    animation-delay: 0.5s;
    transform-origin: 70% 70%;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes wave {
    0% {
      transform: rotate(0deg);
    }
    10% {
      transform: rotate(14deg);
    }
    20% {
      transform: rotate(-8deg);
    }
    30% {
      transform: rotate(14deg);
    }
    40% {
      transform: rotate(-4deg);
    }
    50% {
      transform: rotate(10deg);
    }
    60%,
    100% {
      transform: rotate(0deg);
    }
  }

  /* Light mode adjustments */
  html[data-theme="light"] .terminal-container {
    background-color: #f8f9fa;
    border-color: var(--color-border);
  }

  html[data-theme="light"] .terminal-header {
    background-color: #e9ecef;
    border-bottom-color: var(--color-border);
  }

  html[data-theme="light"] .terminal-title {
    color: #1f2328;
  }

  html[data-theme="light"] .username {
    color: var(--color-accent);
  }

  html[data-theme="light"] .at-symbol {
    color: #24292f;
  }

  html[data-theme="light"] .hostname {
    color: var(--color-terminal-green);
  }

  html[data-theme="light"] .path {
    color: #0969da;
  }

  html[data-theme="light"] .command {
    color: #24292f;
  }

  html[data-theme="light"] .valid-command {
    color: var(--color-terminal-green);
    font-weight: 400;
  }

  html[data-theme="light"] .command-flag {
    color: var(--color-terminal-green);
  }

  html[data-theme="light"] .argument {
    color: #24292f;
  }

  html[data-theme="light"] .terminal-output {
    color: #656d76;
  }

  html[data-theme="light"] .file-permissions {
    color: #0969da;
  }

  html[data-theme="light"] .directory {
    color: #0969da;
    font-weight: 400;
    text-decoration: none;
  }

  html[data-theme="light"] .directory:hover {
    color: #0550ae;
    text-decoration: underline;
  }

  html[data-theme="light"] .symlink-path {
    color: var(--color-accent);
    font-weight: 500;
  }

  html[data-theme="light"] .symlink-path:hover {
    color: #0550ae;
    text-decoration: underline;
  }

  html[data-theme="light"] .git-remotes {
    margin-left: 1.5rem;
  }

  html[data-theme="light"] .remote-name {
    color: #24292f;
  }

  html[data-theme="light"] .remote-url {
    color: var(--color-accent);
  }

  html[data-theme="light"] .remote-url:hover {
    color: var(--color-terminal-green);
    text-decoration: underline;
  }

  html[data-theme="light"] .typed-text :global(.cmd) {
    color: var(--color-terminal-green);
  }

  html[data-theme="light"] .typed-text :global(.args) {
    color: #24292f;
  }

  html[data-theme="light"] .typed-text :global(.comment) {
    color: #656d76;
  }

  html[data-theme="light"] .file-name {
    color: #24292f;
  }

  /* Mobile responsive styles */
  @media (max-width: 768px) {
    .terminal-container {
      margin: 1rem auto 0 auto;
      border-radius: 6px;
      max-width: none;
    }

    .terminal-header {
      padding: 0.5rem 0.75rem;
      border-top-left-radius: 6px;
      border-top-right-radius: 6px;
    }

    .terminal-title {
      font-size: 0.75rem;
    }

    .btn {
      width: 0.625rem;
      height: 0.625rem;
    }

    .terminal-body {
      padding: 1.25rem;
      min-height: 250px;
    }

    .terminal-output {
      margin-left: 1rem;
    }

    .git-remotes {
      margin-left: 1rem;
    }

    .url-short {
      display: inline;
    }

    .url-full {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .terminal-container {
      margin: 0.5rem auto 0 auto;
    }

    .terminal-header {
      padding: 0.5rem 0.75rem;
    }

    .terminal-title {
      font-size: 0.7rem;
    }

    .terminal-body {
      padding: 1rem;
      min-height: 200px;
    }

    .terminal-output {
      margin-left: 0.75rem;
    }

    .git-remotes {
      margin-left: 0.75rem;
    }

    .terminal-buttons {
      gap: 0.375rem;
    }

    .btn {
      width: 0.5rem;
      height: 0.5rem;
    }
  }
</style>

<script>
  function initTypingAnimation() {
    const typedTextElement = document.querySelector(".typed-text");
    if (!typedTextElement) return;

    const messages: string[] = JSON.parse(
      typedTextElement.getAttribute("data-messages") || "[]"
    );
    if (messages.length === 0) return;

    let messageIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let isPaused = false;

    function escapeHtml(text: string): string {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function parseAndColorize(text: string): string {
      if (!text) return "";

      // If starts with #, entire line is a comment
      if (text.trimStart().startsWith("#")) {
        return `<span class="comment">${escapeHtml(text)}</span>`;
      }

      // Split by # to separate command from inline comment
      const hashIndex = text.indexOf("#");
      let commandPart = text;
      let commentPart = "";

      if (hashIndex !== -1) {
        commandPart = text.substring(0, hashIndex);
        commentPart = text.substring(hashIndex);
      }

      // Split command part: first word is command, rest are args
      const trimmed = commandPart.trim();
      const firstSpaceIndex = trimmed.indexOf(" ");

      let result = "";

      if (firstSpaceIndex === -1) {
        // Only command, no args
        if (trimmed) {
          result += `<span class="cmd">${escapeHtml(trimmed)}</span>`;
        }
      } else {
        // Command with args
        const command = trimmed.substring(0, firstSpaceIndex);
        const args = trimmed.substring(firstSpaceIndex);

        result += `<span class="cmd">${escapeHtml(command)}</span>`;
        result += `<span class="args">${escapeHtml(args)}</span>`;
      }

      if (commentPart) {
        // Check if there's space before the comment in original text
        const spaceBeforeComment =
          commandPart.length > 0 &&
          commandPart.charAt(commandPart.length - 1) === " "
            ? " "
            : "";
        result += `<span class="comment">${spaceBeforeComment}${escapeHtml(commentPart)}</span>`;
      }

      return result;
    }

    function type() {
      if (!typedTextElement) return;

      const currentMessage = messages[messageIndex];

      if (isPaused) {
        setTimeout(type, 2000);
        isPaused = false;
        isDeleting = true;
        return;
      }

      if (isDeleting) {
        const displayText = currentMessage.substring(0, charIndex);
        typedTextElement.innerHTML = parseAndColorize(displayText);
        charIndex--;

        if (charIndex < 0) {
          isDeleting = false;
          messageIndex = (messageIndex + 1) % messages.length;
          charIndex = 0;
          setTimeout(type, 500);
          return;
        }
      } else {
        const displayText = currentMessage.substring(0, charIndex);
        typedTextElement.innerHTML = parseAndColorize(displayText);
        charIndex++;

        if (charIndex > currentMessage.length) {
          isPaused = true;
          setTimeout(type, 2000);
          return;
        }
      }

      const typingSpeed = isDeleting ? 30 : 80;
      setTimeout(type, typingSpeed);
    }

    // Start typing after a short delay
    setTimeout(type, 1000);
  }

  // Initialize on page load
  document.addEventListener("astro:page-load", initTypingAnimation);
</script>
