---

---

<div class="terminal-container">
  <div class="terminal-header">
    <div class="terminal-buttons">
      <span class="btn btn-close"></span>
      <span class="btn btn-minimize"></span>
      <span class="btn btn-maximize"></span>
    </div>
    <div class="terminal-title">Dev@Home:~$</div>
  </div>
  <div class="terminal-body">
    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Home</span
      ><span class="path">:~$</span>
      <span class="command valid-command">whoami</span>
    </div>
    <div class="terminal-output">Software Engineer | Tech Enthusiast</div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Home</span
      ><span class="path">:~$</span>
      <span class="command valid-command">cat about.txt</span>
    </div>
    <div class="terminal-output">
      Hey there, curious explorer! 👋
      <br />
      Welcome to my little corner of the internet.
      <br />
      <br />
      I'm Devadathan (most people call me <b><i>Dev</i></b>), a software
      engineer from India.
      <br />
      This is where I write about tech, software development, thoughts,
      <br />
      and occasionally reflect on life's complexities.
    </div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Home</span
      ><span class="path">:~$</span>
      <span class="command valid-command">ls -la mindspace/</span>
    </div>
    <div class="terminal-output">
      drwxr-xr-x backend-engineering/
      <br />
      drwxr-xr-x linux/
      <br />
      drwxr-xr-x cloud/
      <br />
      drwxr-xr-x homelab/
      <br />
      rw-r--r--- .and-more/
    </div>

    <div class="terminal-line">
      <span class="username">Dev</span><span class="at-symbol">@</span><span
        class="hostname">Home</span
      ><span class="path">:~$</span>
      <span class="command cursor-blink">_</span>
    </div>
  </div>
</div>

<style>
  .terminal-container {
    background-color: #1a1e23;
    border: 1px solid #30363d;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    max-width: 54rem;
    margin: 2rem auto 4rem auto;
    font-family: inherit;
  }

  .terminal-header {
    background-color: #21262d;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #30363d;
  }

  .terminal-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .btn {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
  }

  .btn-close {
    background-color: #ff5f56;
  }

  .btn-minimize {
    background-color: #ffbd2e;
  }

  .btn-maximize {
    background-color: #27ca3f;
  }

  .terminal-title {
    color: #f0f6fc;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .terminal-body {
    padding: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.75;
    min-height: 320px;
  }

  .terminal-line {
    margin-bottom: 0.5rem;
  }

  .username {
    color: #7dd3fc;
    margin-right: 0;
  }

  .at-symbol {
    color: #f0f6fc;
    margin: 0;
  }

  .hostname {
    color: #fbbf24;
    margin: 0;
  }

  .path {
    color: #58a6ff;
    margin-right: 0.5rem;
  }

  .command {
    color: #f0f6fc;
    margin-left: 0.5rem;
  }

  .valid-command {
    color: #22c55e;
  }

  .terminal-output {
    color: #e6edf3;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .cursor-blink {
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  /* Light mode adjustments */
  html[data-theme="light"] .terminal-container {
    background-color: #f8f9fa;
    border-color: #d0d7de;
  }

  html[data-theme="light"] .terminal-header {
    background-color: #e9ecef;
    border-bottom-color: #d0d7de;
  }

  html[data-theme="light"] .terminal-title {
    color: #1f2328;
  }

  html[data-theme="light"] .username {
    color: #0284c7;
  }

  html[data-theme="light"] .at-symbol {
    color: #1f2328;
  }

  html[data-theme="light"] .hostname {
    color: #d97706;
  }

  html[data-theme="light"] .path {
    color: #0969da;
  }

  html[data-theme="light"] .command {
    color: #1f2328;
  }

  html[data-theme="light"] .valid-command {
    color: #16a34a;
  }

  html[data-theme="light"] .terminal-output {
    color: #656d76;
  }
</style>
