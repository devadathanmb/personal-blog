---
// Storm background: depth-layered wind-driven rain + dynamic multi-bolt
// lightning.
//
// Performance-first:
//  - Rain drops are pre-partitioned into opacity buckets, so each frame is a
//    single pass that both advances positions and batches strokes (4 draw
//    calls total instead of one per drop). The bucket also encodes depth
//    (speed/length/wind-lean/width), so parallax costs nothing extra.
//  - Lightning glow is drawn as ONE batched shadow pass per bolt instead of
//    toggling the expensive canvas shadow once per segment.
//  - DPR-aware sizing, 30 fps throttle on mobile, and the RAF loop fully stops
//    when the tab is hidden or when reduced motion is set.
//
// The effect is theme-aware: rain renders in both themes (soft grey-blue in
// light mode), re-reading the theme every frame so it adapts on toggle. The
// lightning is a night-time effect only — bolts strike, flash and flicker in
// dark mode, while light mode is a calm daytime drizzle with no bolts.
//
// Lightning strikes from randomised horizontal positions at the top of the
// screen, each bolt with its own intensity tier (major / minor / distant) and
// a subtle channel flicker for a more natural strobe.
---

<bg-storm
  class="z--1 fixed top-0 bottom-0 left-0 right-0 pointer-events-none print:hidden"
>
</bg-storm>

<style>
  bg-storm canvas {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  class BgStormElement extends HTMLElement {
    private animId: number | null = null
    private canvas: HTMLCanvasElement | null = null
    private onVisibility: (() => void) | null = null
    private sync: (() => void) | null = null

    connectedCallback() {
      this.canvas = document.createElement('canvas')
      this.canvas.style.width = '100%'
      this.canvas.style.height = '100%'
      this.appendChild(this.canvas)
      this.init()
    }

    disconnectedCallback() {
      if (this.animId !== null) {
        cancelAnimationFrame(this.animId)
        this.animId = null
      }
      if (this.onVisibility)
        document.removeEventListener('visibilitychange', this.onVisibility)
    }

    init() {
      const canvas = this.canvas!
      const ctx = canvas.getContext('2d')!

      // ─── Device capability detection ─────────────────────────────────────
      const isMobile = window.matchMedia('(max-width: 768px)').matches
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      const DPR = Math.min(window.devicePixelRatio || 1, isMobile ? 1 : 2)
      const FRAME_MS = isMobile ? 1000 / 30 : 1000 / 60
      let lastFrameTime = 0

      const isDark = () => document.documentElement.classList.contains('dark')

      let W = 0
      let H = 0

      const resize = () => {
        const newW = window.innerWidth
        // Only react to WIDTH changes. On mobile, scrolling collapses/expands
        // the address bar, firing resize with a changed HEIGHT only; rebuilding
        // the canvas there clears it and resets every drop, which looks jarring
        // mid-scroll. Keying off width keeps it stable (rotation still fires).
        if (newW === W) return
        W = newW
        H = window.innerHeight
        canvas.width = Math.round(W * DPR)
        canvas.height = Math.round(H * DPR)
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0)
        initDrops()
      }

      let resizeTimer: ReturnType<typeof setTimeout> | null = null
      window.addEventListener('resize', () => {
        if (resizeTimer) clearTimeout(resizeTimer)
        resizeTimer = setTimeout(resize, 120)
      })

      // ─── Rain ─────────────────────────────────────────────────────────────
      //
      // Drops are stored already partitioned by opacity bucket. Each frame we
      // walk one bucket at a time, advancing every drop AND adding it to that
      // bucket's stroke path — so we set globalAlpha just 4 times per frame and
      // make a single pass over the drops.

      interface Drop {
        x: number
        y: number
        speed: number // px/frame
        length: number // streak px
      }

      // 4 tiers, far → near. The opacity bucket now also encodes DEPTH: nearer
      // layers fall faster, streak longer, lean more with the wind and draw a
      // touch thicker. This turns a flat sheet of rain into layered parallax at
      // no extra cost (same drop count, same 4 batched strokes).
      const DARK_ALPHAS = [0.03, 0.055, 0.08, 0.11]
      const LIGHT_ALPHAS = [0.04, 0.065, 0.09, 0.12]
      const DEPTH_SPEED = [1.6, 2.5, 3.6, 5.0] // base px/frame per bucket
      const DEPTH_LEN = [7, 12, 18, 26] // base streak px per bucket
      const DEPTH_DRIFT = [0.3, 0.5, 0.75, 1.0] // wind responsiveness per bucket
      const DEPTH_WIDTH = [0.6, 0.8, 1.0, 1.3] // stroke width per bucket
      const BUCKETS = 4

      const DROP_COUNT = isMobile ? 100 : 180
      const buckets: Drop[][] = Array.from({ length: BUCKETS }, () => [])

      const resetDrop = (d: Drop, bucket: number) => {
        d.x = Math.random() * (W + 40) - 20
        d.y = -(10 + Math.random() * 28)
        d.speed = DEPTH_SPEED[bucket] * (0.85 + Math.random() * 0.4)
        d.length = DEPTH_LEN[bucket] * (0.8 + Math.random() * 0.5)
      }

      const initDrops = () => {
        for (let b = 0; b < BUCKETS; b++) buckets[b].length = 0
        for (let i = 0; i < DROP_COUNT; i++) {
          const bucket = i % BUCKETS // even density across depth layers
          const d: Drop = { x: 0, y: 0, speed: 0, length: 0 }
          resetDrop(d, bucket)
          d.y = Math.random() * H // spread across the screen on first frame
          buckets[bucket].push(d)
        }
      }

      // ─── Lightning ────────────────────────────────────────────────────────
      type Intensity = 'major' | 'minor' | 'distant'

      interface Seg {
        x1: number
        y1: number
        x2: number
        y2: number
        branch: boolean
      }

      interface Bolt {
        segs: Seg[]
        alpha: number
        phase: 'in' | 'hold' | 'out'
        phaseStart: number
        peakAlpha: number
        boltIn: number
        boltHold: number
        boltOut: number
        flashMult: number
        glowBlur: number
        coreWidth: number
      }

      const MAX_BOLTS = 3
      const activeBolts: Bolt[] = []

      // Fire the first bolt quickly so it's visible on load, then settle into a
      // realistic inter-strike rhythm.
      let nextBoltAt = Date.now() + 800 + Math.random() * 700

      const INTENSITY_CONFIG: Record<
        Intensity,
        {
          peakAlpha: number
          boltIn: number
          boltHold: number
          boltOut: number
          depth: number
          initSegLen: number
          initWidth: number
          flashMult: number
          glowBlur: number
          branchProb: number
        }
      > = {
        major: {
          peakAlpha: 1.0,
          boltIn: 45,
          boltHold: 110,
          boltOut: 650,
          depth: 10,
          initSegLen: 52,
          initWidth: 2.4,
          flashMult: 1.0,
          glowBlur: 16,
          branchProb: 0.38,
        },
        minor: {
          peakAlpha: 0.78,
          boltIn: 40,
          boltHold: 75,
          boltOut: 450,
          depth: 7,
          initSegLen: 40,
          initWidth: 1.6,
          flashMult: 0.6,
          glowBlur: isMobile ? 0 : 8,
          branchProb: 0.28,
        },
        distant: {
          peakAlpha: 0.55,
          boltIn: 30,
          boltHold: 45,
          boltOut: 320,
          depth: 6,
          initSegLen: 32,
          initWidth: 1.1,
          flashMult: 0.35,
          glowBlur: 0,
          branchProb: 0.15,
        },
      }

      const pickIntensity = (): Intensity => {
        const r = Math.random()
        if (r < 0.3) return 'distant'
        if (r < 0.78) return 'minor'
        return 'major'
      }

      /** Recursively build a jagged branching bolt downward. */
      function genBolt(
        x: number,
        y: number,
        angle: number,
        segLen: number,
        depth: number,
        branch: boolean,
        branchProb: number,
        out: Seg[]
      ) {
        if (depth <= 0 || y > H + 30) return

        const jitter = (Math.random() - 0.5) * 40
        const nx = x + Math.sin(angle) * segLen + jitter
        const ny = y + Math.cos(angle) * segLen

        out.push({ x1: x, y1: y, x2: nx, y2: ny, branch })

        genBolt(
          nx,
          ny,
          angle + (Math.random() - 0.5) * 0.24,
          segLen * 0.87,
          depth - 1,
          branch,
          branchProb,
          out
        )

        if (Math.random() < branchProb && depth > 2) {
          const dir = Math.random() > 0.5 ? 1 : -1
          const fAngle = angle + dir * (0.38 + Math.random() * 0.5)
          genBolt(
            nx,
            ny,
            fAngle,
            segLen * 0.52,
            Math.floor(depth * 0.55),
            true,
            branchProb * 0.5,
            out
          )
        }
      }

      const triggerBolt = () => {
        if (activeBolts.length >= MAX_BOLTS) return

        const intensity = pickIntensity()
        const cfg = INTENSITY_CONFIG[intensity]

        const segs: Seg[] = []
        const sx = W * 0.05 + Math.random() * W * 0.9
        genBolt(
          sx,
          -8,
          0,
          cfg.initSegLen,
          cfg.depth,
          false,
          cfg.branchProb,
          segs
        )

        activeBolts.push({
          segs,
          alpha: 0,
          phase: 'in',
          phaseStart: performance.now(),
          peakAlpha: cfg.peakAlpha,
          boltIn: cfg.boltIn,
          boltHold: cfg.boltHold,
          boltOut: cfg.boltOut,
          flashMult: cfg.flashMult,
          glowBlur: cfg.glowBlur,
          coreWidth: cfg.initWidth,
        })
      }

      // ─── Draw loop ────────────────────────────────────────────────────────
      const draw = (timestamp: number) => {
        this.animId = requestAnimationFrame(draw)

        const elapsed = timestamp - lastFrameTime
        if (elapsed < FRAME_MS) return
        lastFrameTime = timestamp - (elapsed % FRAME_MS)

        ctx.clearRect(0, 0, W, H)
        const dark = isDark()
        const now = performance.now()

        // ── 1. Lightning (dark-mode only) ────────────────────────────────────
        //
        // Bolts only strike at night. In light mode we keep a calm daytime
        // drizzle, so we clear any in-flight bolts and skip the storm logic.
        let combinedFlash = 0
        let maxLightBoost = 0

        if (dark) {
          // Spawn new bolts.
          if (Date.now() >= nextBoltAt) {
            triggerBolt()
            const followUp = Math.random() < 0.28
            nextBoltAt =
              Date.now() +
              (followUp
                ? 350 + Math.random() * 700
                : 5000 + Math.random() * 7000)
          }

          // Advance all active bolt states.
          for (let i = activeBolts.length - 1; i >= 0; i--) {
            const b = activeBolts[i]
            const bElapsed = now - b.phaseStart

            if (b.phase === 'in') {
              b.alpha = Math.min(
                b.peakAlpha,
                (bElapsed / b.boltIn) * b.peakAlpha
              )
              if (bElapsed >= b.boltIn) {
                b.phase = 'hold'
                b.phaseStart = now
              }
            } else if (b.phase === 'hold') {
              b.alpha = b.peakAlpha
              if (bElapsed >= b.boltHold) {
                b.phase = 'out'
                b.phaseStart = now
              }
            } else {
              const t = Math.min(1, bElapsed / b.boltOut)
              b.alpha = b.peakAlpha * (1 - t * t * (3 - 2 * t)) // smoothstep
              if (b.alpha < 0.002) {
                activeBolts.splice(i, 1)
                continue
              }
            }

            combinedFlash += b.alpha * b.flashMult
            maxLightBoost = Math.max(maxLightBoost, b.alpha * b.peakAlpha)
          }

          combinedFlash = Math.min(combinedFlash, 1)
        } else if (activeBolts.length) {
          activeBolts.length = 0
        }

        // ── 2. Rain — wind-driven, batched by opacity bucket + depth ─────────
        //
        // A slowly varying global wind, with a couple of incommensurate gust
        // terms layered on, makes the rain sway and slant in natural waves
        // instead of falling in straight lines. The same value drives both the
        // horizontal drift and the streak lean.
        const wind =
          Math.sin(now * 0.00018) * 0.7 +
          Math.sin(now * 0.00005) * 0.4 +
          Math.sin(now * 0.00031 + 1.7) * 0.3 +
          Math.sin(now * 0.000071) * 0.2

        const lightBoost = maxLightBoost * 0.1
        const alphaTable = dark ? DARK_ALPHAS : LIGHT_ALPHAS
        const rainColor = dark ? '180, 212, 238' : '45, 62, 92'

        ctx.strokeStyle = `rgb(${rainColor})`
        for (let b = 0; b < BUCKETS; b++) {
          ctx.globalAlpha = Math.min(0.85, alphaTable[b] + lightBoost)
          ctx.lineWidth = DEPTH_WIDTH[b]
          const drift = DEPTH_DRIFT[b]
          ctx.beginPath()
          const bucket = buckets[b]
          for (const d of bucket) {
            // Advance position (gravity + wind drift). Nearer layers (higher
            // bucket) drift and lean more, which sells the parallax.
            d.y += d.speed
            d.x += wind * 0.6 * drift
            if (d.y - d.length > H) resetDrop(d, b)
            const lean = wind * d.length * 0.35 * drift
            ctx.moveTo(d.x, d.y)
            ctx.lineTo(d.x + lean, d.y + d.length)
          }
          ctx.stroke()
        }
        ctx.globalAlpha = 1

        // ── 3. Lightning: flash overlay + bolt segments ──────────────────────
        // Reached only in dark mode (bolts never spawn in light), so the flash
        // is always the night-time strength.
        if (activeBolts.length > 0) {
          if (combinedFlash > 0.05) {
            const flashAlpha = combinedFlash * combinedFlash * 0.055
            ctx.fillStyle = `rgba(200, 220, 255, ${flashAlpha})`
            ctx.fillRect(0, 0, W, H)
          }

          ctx.lineCap = 'round'
          for (const bolt of activeBolts) {
            if (bolt.alpha < 0.01) continue

            // Subtle channel flicker while the bolt is bright (real strikes
            // strobe rapidly); the fade-out stays smooth.
            const flicker =
              bolt.phase === 'out' ? 1 : 0.78 + Math.random() * 0.22
            const a = bolt.alpha * flicker

            // 4a. Glow — a single batched shadow pass over the main channel.
            if (bolt.glowBlur > 0) {
              ctx.shadowBlur = bolt.glowBlur * bolt.alpha
              ctx.shadowColor = 'rgba(140, 190, 255, 0.6)'
              ctx.lineWidth = bolt.coreWidth * bolt.alpha
              ctx.strokeStyle = `rgba(200, 230, 255, ${a * 0.5})`
              ctx.beginPath()
              for (const s of bolt.segs) {
                if (s.branch) continue
                ctx.moveTo(s.x1, s.y1)
                ctx.lineTo(s.x2, s.y2)
              }
              ctx.stroke()
              ctx.shadowBlur = 0
            }

            // 4b. Crisp main channel (one batched stroke, no shadow).
            ctx.lineWidth = Math.max(0.6, bolt.coreWidth * bolt.alpha)
            ctx.strokeStyle = `rgba(220, 240, 255, ${a * 0.88})`
            ctx.beginPath()
            for (const s of bolt.segs) {
              if (s.branch) continue
              ctx.moveTo(s.x1, s.y1)
              ctx.lineTo(s.x2, s.y2)
            }
            ctx.stroke()

            // 4c. Branches (dimmer, thinner, one batched stroke).
            ctx.lineWidth = Math.max(0.4, bolt.coreWidth * 0.45 * bolt.alpha)
            ctx.strokeStyle = `rgba(165, 200, 255, ${a * 0.4})`
            ctx.beginPath()
            for (const s of bolt.segs) {
              if (!s.branch) continue
              ctx.moveTo(s.x1, s.y1)
              ctx.lineTo(s.x2, s.y2)
            }
            ctx.stroke()
          }
          ctx.lineCap = 'butt'
        }
      }

      // ─── Lifecycle ───────────────────────────────────────────────────────
      // Run whenever the tab is visible and the user hasn't asked for reduced
      // motion. The draw loop itself adapts to the theme each frame (rain in
      // both modes, lightning only in dark).
      this.sync = () => {
        const shouldRun = !document.hidden && !reduceMotion
        if (shouldRun && this.animId === null) {
          lastFrameTime = 0
          this.animId = requestAnimationFrame(draw)
        } else if (!shouldRun && this.animId !== null) {
          cancelAnimationFrame(this.animId)
          this.animId = null
          ctx.clearRect(0, 0, W, H)
        }
      }

      this.onVisibility = () => this.sync?.()
      document.addEventListener('visibilitychange', this.onVisibility)

      resize()
      this.sync()
    }
  }

  customElements.define('bg-storm', BgStormElement)
</script>
