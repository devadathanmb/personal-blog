---
// Custom "Nebula" background: soft drifting light orbs
---

<bg-nebula
  class="z--1 fixed top-0 bottom-0 left-0 right-0 pointer-events-none print:hidden"
>
</bg-nebula>

<style>
  bg-nebula canvas {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  class BgNebulaElement extends HTMLElement {
    private animId: number | null = null
    private canvas: HTMLCanvasElement | null = null

    connectedCallback() {
      this.canvas = document.createElement('canvas')
      this.canvas.style.width = '100%'
      this.canvas.style.height = '100%'
      this.appendChild(this.canvas)
      this.init()
    }

    disconnectedCallback() {
      if (this.animId !== null) {
        cancelAnimationFrame(this.animId)
        this.animId = null
      }
    }

    init() {
      const canvas = this.canvas!
      const ctx = canvas.getContext('2d')!

      const isDark = () => document.documentElement.classList.contains('dark')

      let W = window.innerWidth
      let H = window.innerHeight

      const resize = () => {
        W = window.innerWidth
        H = window.innerHeight
        canvas.width = W
        canvas.height = H
      }
      resize()
      window.addEventListener('resize', resize)

      // Each orb drifts slowly
      interface Orb {
        x: number
        y: number
        r: number
        dx: number
        dy: number
        hue: number
        alpha: number
        alphaDir: number
      }

      const ORB_COUNT = 10
      const orbs: Orb[] = []

      for (let i = 0; i < ORB_COUNT; i++) {
        orbs.push({
          x: Math.random() * W,
          y: Math.random() * H,
          r: Math.random() * 300 + 200,
          dx: (Math.random() - 0.5) * 0.4,
          dy: (Math.random() - 0.5) * 0.4,
          hue: Math.random() * 60 + 200, // cool blue-purple range
          alpha: Math.random() * 0.1 + 0.05,
          alphaDir: Math.random() > 0.5 ? 1 : -1,
        })
      }

      const draw = () => {
        ctx.clearRect(0, 0, W, H)

        const dark = isDark()

        for (const orb of orbs) {
          // Update position
          orb.x += orb.dx
          orb.y += orb.dy

          // Bounce off edges with margin
          if (orb.x < -orb.r) orb.x = W + orb.r
          if (orb.x > W + orb.r) orb.x = -orb.r
          if (orb.y < -orb.r) orb.y = H + orb.r
          if (orb.y > H + orb.r) orb.y = -orb.r

          // Breathe alpha
          orb.alpha += orb.alphaDir * 0.0003
          if (orb.alpha > 0.12) orb.alphaDir = -1
          if (orb.alpha < 0.03) orb.alphaDir = 1

          const a = dark ? orb.alpha : orb.alpha * 0.7

          const grad = ctx.createRadialGradient(
            orb.x,
            orb.y,
            0,
            orb.x,
            orb.y,
            orb.r
          )
          grad.addColorStop(0, `hsla(${orb.hue}, 70%, 65%, ${a})`)
          grad.addColorStop(1, `hsla(${orb.hue}, 70%, 65%, 0)`)

          ctx.beginPath()
          ctx.arc(orb.x, orb.y, orb.r, 0, Math.PI * 2)
          ctx.fillStyle = grad
          ctx.fill()
        }

        this.animId = requestAnimationFrame(draw)
      }

      draw()
    }
  }

  customElements.define('bg-nebula', BgNebulaElement)
</script>
