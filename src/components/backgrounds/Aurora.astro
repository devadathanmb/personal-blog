---
// Aurora background: a few large, slow-drifting luminous blobs that blend into
// soft shifting bands of light — a calmer, more ambient alternative to Storm.
//
// Performance-first:
//  - The canvas backing store is rendered at a HEAVILY downscaled resolution
//    (viewport / DOWNSCALE) and stretched to 100% via CSS. The effect is all
//    soft gradients, so the upscale is invisible — but it cuts pixel-fill cost
//    (the only real expense here) by ~16x. No blur filter is used at all; the
//    softness comes for free from radial-gradient falloff.
//  - Just a handful of `fillRect`s per frame (one per blob), each a cached-shape
//    radial gradient rebuilt only because its centre moves.
//  - 30 fps throttle (the drift is slow enough that more is wasteful), the RAF
//    loop fully stops when the tab is hidden, and reduced-motion renders a
//    single static frame with no loop.
//
// Theme-aware, re-read every frame so it adapts live on toggle:
//  - Dark mode uses additive ('lighter') compositing for a glowing aurora.
//  - Light mode uses normal compositing with low-alpha tints for a gentle wash
//    that doesn't blow out toward white on a bright page.
---

<bg-aurora
  class="z--1 fixed top-0 bottom-0 left-0 right-0 pointer-events-none print:hidden"
>
</bg-aurora>

<style>
  bg-aurora canvas {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  class BgAuroraElement extends HTMLElement {
    private animId: number | null = null
    private canvas: HTMLCanvasElement | null = null
    private onResize: (() => void) | null = null
    private onVisibility: (() => void) | null = null

    connectedCallback() {
      this.canvas = document.createElement('canvas')
      this.canvas.style.width = '100%'
      this.canvas.style.height = '100%'
      this.appendChild(this.canvas)
      this.init()
    }

    disconnectedCallback() {
      if (this.animId !== null) {
        cancelAnimationFrame(this.animId)
        this.animId = null
      }
      if (this.onResize) window.removeEventListener('resize', this.onResize)
      if (this.onVisibility)
        document.removeEventListener('visibilitychange', this.onVisibility)
    }

    init() {
      const canvas = this.canvas!
      const ctx = canvas.getContext('2d')!

      const isDark = () => document.documentElement.classList.contains('dark')

      // ─── Device capability detection ─────────────────────────────────────
      const isMobile = window.matchMedia('(max-width: 768px)').matches
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches
      // Render the backing store this many times smaller than the viewport.
      // The blobs are soft, so the upscale never shows; this is where almost
      // all the savings come from. Coarser still on mobile.
      const DOWNSCALE = isMobile ? 6 : 4
      // The drift is slow; 30 fps looks identical to 60 here and halves work.
      const FRAME_MS = 1000 / 30
      let lastFrameTime = 0

      let W = 0 // internal (downscaled) buffer width
      let H = 0 // internal (downscaled) buffer height

      // ─── Blobs ───────────────────────────────────────────────────────────
      //
      // Each blob orbits a base point via two slow, out-of-phase sine waves so
      // the field never repeats cleanly. Hues are fixed per blob; only the
      // alpha and composite mode change with the theme.

      interface Blob {
        baseX: number // 0..1 of width
        baseY: number // 0..1 of height
        ampX: number // drift amplitude, fraction of width
        ampY: number
        freqX: number // radians/sec
        freqY: number
        phaseX: number
        phaseY: number
        radius: number // fraction of min(W, H)
        hue: number // dark-mode hue
        hueLight: number // light-mode hue (kept in a tighter cool band)
      }

      // Dark mode: a wide aurora palette (teal → cyan → blue → violet, plus a
      // warm ember) — the additive glow keeps disparate hues vivid.
      // Light mode: a tighter cool band (teal → sky → periwinkle). On a white
      // page, source-over blends of clashing hues grey out into mud, so the
      // light hues are kept close together to stay a clean, harmonious wash.
      const blobs: Blob[] = [
        {
          baseX: 0.25,
          baseY: 0.3,
          ampX: 0.2,
          ampY: 0.17,
          freqX: 0.14,
          freqY: 0.19,
          phaseX: 0,
          phaseY: 1.7,
          radius: 0.7,
          hue: 165,
          hueLight: 185,
        },
        {
          baseX: 0.7,
          baseY: 0.25,
          ampX: 0.22,
          ampY: 0.15,
          freqX: 0.12,
          freqY: 0.17,
          phaseX: 2.1,
          phaseY: 0.6,
          radius: 0.75,
          hue: 200,
          hueLight: 205,
        },
        {
          baseX: 0.55,
          baseY: 0.65,
          ampX: 0.18,
          ampY: 0.2,
          freqX: 0.1,
          freqY: 0.15,
          phaseX: 4.0,
          phaseY: 3.3,
          radius: 0.8,
          hue: 265,
          hueLight: 225,
        },
        {
          baseX: 0.85,
          baseY: 0.7,
          ampX: 0.16,
          ampY: 0.14,
          freqX: 0.16,
          freqY: 0.11,
          phaseX: 1.2,
          phaseY: 5.1,
          radius: 0.6,
          hue: 315,
          hueLight: 245,
        },
      ]

      const resize = () => {
        const newW = Math.max(1, Math.round(window.innerWidth / DOWNSCALE))
        const newH = Math.max(1, Math.round(window.innerHeight / DOWNSCALE))
        // Only react to WIDTH changes. On mobile, scrolling collapses/expands
        // the browser address bar, which fires `resize` with a changed HEIGHT.
        // Reassigning canvas.width/height clears the backing store to
        // transparent, and against the throttled draw loop that blank frame
        // shows as a flicker on every scroll. Ignoring height-only changes
        // removes it; the canvas (CSS height 100%) just stretches the buffer,
        // which is invisible on a soft blurred effect. Rotation changes width,
        // so it's still handled.
        if (newW === W) return
        W = newW
        H = newH
        canvas.width = W
        canvas.height = H
        // Redraw at once so the freshly-cleared buffer is never shown blank.
        lastFrameTime = 0
        drawFrame(performance.now() / 1000)
      }

      let resizeTimer: ReturnType<typeof setTimeout> | null = null
      this.onResize = () => {
        if (resizeTimer) clearTimeout(resizeTimer)
        resizeTimer = setTimeout(resize, 120)
      }
      window.addEventListener('resize', this.onResize)

      // ─── Draw ──────────────────────────────────────────────────────────────
      const drawFrame = (t: number) => {
        const dark = isDark()
        ctx.clearRect(0, 0, W, H)
        ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over'

        const minDim = Math.min(W, H)
        // Center alpha per blob, kept low so the aurora reads as a faint shift
        // behind content and never competes with text. The visible movement
        // comes from drift speed/travel, not brightness.
        const centerAlpha = dark ? 0.13 : 0.06
        // Light mode uses medium-saturation pastels so each blob actually tints
        // the white page (rather than washing out) while staying gentle.
        const sat = dark ? 75 : 62
        const light = dark ? 55 : 64

        for (const b of blobs) {
          const hue = dark ? b.hue : b.hueLight
          const cx = (b.baseX + Math.sin(t * b.freqX + b.phaseX) * b.ampX) * W
          const cy = (b.baseY + Math.cos(t * b.freqY + b.phaseY) * b.ampY) * H
          const r = b.radius * minDim

          const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, r)
          g.addColorStop(0, `hsla(${hue}, ${sat}%, ${light}%, ${centerAlpha})`)
          g.addColorStop(
            0.5,
            `hsla(${hue}, ${sat}%, ${light}%, ${centerAlpha * 0.35})`
          )
          g.addColorStop(1, `hsla(${hue}, ${sat}%, ${light}%, 0)`)

          ctx.fillStyle = g
          ctx.fillRect(0, 0, W, H)
        }

        ctx.globalCompositeOperation = 'source-over'
      }

      const draw = (timestamp: number) => {
        this.animId = requestAnimationFrame(draw)

        const elapsed = timestamp - lastFrameTime
        if (elapsed < FRAME_MS) return
        lastFrameTime = timestamp - (elapsed % FRAME_MS)

        if (document.hidden) return

        drawFrame(timestamp / 1000)
      }

      resize()

      if (reduceMotion) {
        // Honour the preference: one static frame, no loop.
        drawFrame(0)
        return
      }

      // Stop/restart the RAF loop around tab visibility to save battery.
      this.onVisibility = () => {
        if (document.hidden) {
          if (this.animId !== null) {
            cancelAnimationFrame(this.animId)
            this.animId = null
          }
        } else if (this.animId === null) {
          lastFrameTime = 0
          this.animId = requestAnimationFrame(draw)
        }
      }
      document.addEventListener('visibilitychange', this.onVisibility)

      this.animId = requestAnimationFrame(draw)
    }
  }

  customElements.define('bg-aurora', BgAuroraElement)
</script>
