---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";
import IconHeart from "@/assets/icons/IconHeart.svg";
import IconAstro from "@/assets/icons/IconAstro.svg";

const currentYear = new Date().getFullYear();
const commitHash = import.meta.env.GIT_COMMIT_HASH || "unknown";
const githubRepo = "https://github.com/devadathanmb/personal-blog";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
  <div
    class="made-with pb-4 text-center text-sm opacity-70 transition-opacity hover:opacity-100"
  >
    <span class="flex items-center justify-center gap-1.5">
      Made with
      <IconHeart class="heart-icon" />
      using
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 transition-all hover:opacity-80"
        title="Built with Astro"
      >
        <IconAstro class="astro-icon" />
        <span class="astro-text">Astro</span>
      </a>
    </span>
  </div>
  <div
    class="deploy-info pb-6 text-center text-sm opacity-70 transition-opacity hover:opacity-100"
  >
    <span class="shine-text">
      ⚡ Deployed commit: <a
        href={`${githubRepo}/commit/${commitHash}`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono underline decoration-dashed underline-offset-2 transition-all hover:decoration-solid"
        title="View commit on GitHub">{commitHash}</a
      >
    </span>
  </div>
</footer>

<style>
  @keyframes shine {
    from {
      background-position: 250% center;
    }
    to {
      background-position: -250% center;
    }
  }

  .shine-text {
    --shine-dim: rgba(230, 237, 243, 0.5);
    --shine-bright: rgb(255, 255, 255);
    --shine-glow: rgba(139, 148, 158, 0.9);
    display: inline-block;
    background: linear-gradient(
      110deg,
      var(--shine-dim) 0%,
      var(--shine-dim) 35%,
      var(--shine-glow) 45%,
      var(--shine-bright) 50%,
      var(--shine-glow) 55%,
      var(--shine-dim) 65%,
      var(--shine-dim) 100%
    );
    background-size: 250% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 12s linear infinite;
  }

  html[data-theme="light"] .shine-text {
    --shine-dim: rgba(36, 41, 47, 0.5);
    --shine-bright: rgb(0, 0, 0);
    --shine-glow: rgba(36, 41, 47, 0.85);
  }

  .shine-text:hover {
    animation-play-state: paused;
  }

  .shine-text a {
    text-decoration-color: rgba(139, 148, 158, 0.5);
    transition: text-decoration-color 0.2s ease;
  }

  .shine-text a:is(:hover, :focus) {
    text-decoration-color: rgba(139, 148, 158, 0.8);
  }

  .made-with {
    font-size: 0.875rem;
  }

  .astro-icon {
    color: #ff5d01;
    transition: transform 0.3s ease;
    width: 1.25rem;
    height: 1.25rem;
  }

  .astro-text {
    font-weight: 500;
    color: #ff5d01;
  }

  .made-with a:hover .astro-icon {
    transform: rotate(10deg) scale(1.1);
  }

  .heart-icon {
    color: #ef4444;
    animation: heartbeat 2s ease-in-out infinite;
    width: 1rem;
    height: 1rem;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    10%,
    30% {
      transform: scale(1.1);
    }
    20%,
    40% {
      transform: scale(1);
    }
  }

  html[data-theme="light"] .astro-icon,
  html[data-theme="light"] .astro-text {
    color: #ff5d01;
  }

  html[data-theme="light"] .heart-icon {
    color: #dc2626;
  }
</style>
