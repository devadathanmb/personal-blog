---
import Hr from "./Hr.astro";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();
const commitHash = import.meta.env.GIT_COMMIT_HASH || "unknown";
const githubRepo = "https://github.com/devadathanmb/personal-blog";

export interface Props {
  noMarginTop?: boolean;
}

const { noMarginTop = false } = Astro.props;
---

<footer class:list={["w-full", { "mt-auto": !noMarginTop }]}>
  <Hr noPadding />
  <div
    class="flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4"
  >
    <Socials centered />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
  <div
    class="deploy-info pb-6 text-center text-sm opacity-70 transition-opacity hover:opacity-100"
  >
    <span class="shine-text">
      ⚡ Deployed commit: <a
        href={`${githubRepo}/commit/${commitHash}`}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono underline decoration-dashed underline-offset-2 transition-all hover:decoration-solid"
        title="View commit on GitHub">{commitHash}</a
      >
    </span>
  </div>
</footer>

<style>
  @keyframes shine {
    0% {
      background-position: 200% center;
    }
    100% {
      background-position: -200% center;
    }
  }

  .shine-text {
    display: inline-block;
    background-size: 200% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 7s linear infinite;
    transition: all 0.2s ease;
  }

  html[data-theme="dark"] .shine-text {
    background-image: linear-gradient(
      120deg,
      rgba(230, 237, 243, 0.7) 0%,
      rgba(230, 237, 243, 0.7) 40%,
      rgb(255, 255, 255) 50%,
      rgba(230, 237, 243, 0.7) 60%,
      rgba(230, 237, 243, 0.7) 100%
    );
  }

  html[data-theme="light"] .shine-text {
    background-image: linear-gradient(
      120deg,
      rgba(36, 41, 47, 0.7) 0%,
      rgba(36, 41, 47, 0.7) 40%,
      rgb(36, 41, 47) 50%,
      rgba(36, 41, 47, 0.7) 60%,
      rgba(36, 41, 47, 0.7) 100%
    );
  }

  .shine-text:hover {
    animation-play-state: paused;
  }

  .shine-text a {
    color: inherit;
    -webkit-text-fill-color: transparent;
  }
</style>
