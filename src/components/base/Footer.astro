---
import { SITE } from '~/config'
import { execSync } from 'node:child_process'

const currentYear = new Date().getFullYear()
const copyrightText = `© ${currentYear} ${SITE.author}`

let commitHash = 'unknown'
try {
  commitHash =
    import.meta.env.PUBLIC_GIT_SHA ||
    import.meta.env.CF_PAGES_COMMIT_SHA ||
    import.meta.env.GIT_COMMIT_HASH
  if (!commitHash) {
    commitHash = execSync('git rev-parse --short HEAD').toString().trim()
  } else {
    commitHash = commitHash.substring(0, 7)
  }
} catch {
  // fallback if git is not available
}

const githubRepo = 'https://github.com/devadathanmb/personal-blog'
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div class="prose mx-auto op-50">
    <div
      class="flex flex-col sm:flex-row sm:justify-between items-center text-sm whitespace-nowrap"
    >
      <div class="flex lt-sm:flex-col items-center gap-1">
        <span>{copyrightText}</span>
        <span class="lt-sm:hidden">&nbsp;|&nbsp;</span>
        <span class="flex items-center gap-1">
          Built with
          <div class="i-ri-heart-fill heart-icon" aria-hidden="true" />
          using
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="astro-link inline-flex items-center gap-1"
            title="Built with Astro"
          >
            <div class="i-simple-icons-astro astro-icon" aria-hidden="true" />
          </a>
        </span>
      </div>
      {
        commitHash !== 'unknown' && (
          <div class="mt-2 sm:mt-0 flex items-center gap-1">
            <span>
              <span class="i-mage-zap-fill deployed-zap" aria-hidden="true" />
              Deployed commit:
            </span>
            <a
              class="shine-hash font-mono decoration-dashed hover:decoration-solid underline underline-offset-2"
              href={`${githubRepo}/commit/${commitHash}`}
              target="_blank"
              rel="noopener noreferrer"
              title="View commit on GitHub"
            >
              {commitHash}
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* ── Shine animation on commit hash ── */
  @keyframes shine {
    from {
      background-position: 250% center;
    }
    to {
      background-position: -250% center;
    }
  }

  .shine-hash {
    --shine-dim: rgba(200, 200, 200, 0.75);
    --shine-bright: rgb(255, 255, 255);
    --shine-glow: rgba(230, 230, 230, 0.95);
    display: inline-block;
    background: linear-gradient(
      110deg,
      var(--shine-dim) 0%,
      var(--shine-dim) 35%,
      var(--shine-glow) 45%,
      var(--shine-bright) 50%,
      var(--shine-glow) 55%,
      var(--shine-dim) 65%,
      var(--shine-dim) 100%
    );
    background-size: 250% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }

  /* Light mode: dark shine passes through */
  :root:not(.dark) .shine-hash {
    --shine-dim: rgba(80, 80, 80, 0.7);
    --shine-bright: rgb(0, 0, 0);
    --shine-glow: rgba(60, 60, 60, 0.9);
  }

  .shine-hash:hover {
    animation-play-state: paused;
  }

  /* ── Heart icon ── */
  .heart-icon {
    color: #ef4444;
    width: 0.9rem;
    height: 0.9rem;
    animation: heartbeat 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes heartbeat {
    0%   { transform: scale(1); }
    8%   { transform: scale(1.14); }   /* lub — stronger first beat */
    16%  { transform: scale(0.97); }   /* dip between beats */
    24%  { transform: scale(1.08); }   /* dub — softer second beat */
    35%  { transform: scale(1); }      /* settle */
    100% { transform: scale(1); }      /* long rest before next cycle */
  }

  /* ── Zap icon ── */
  .deployed-zap {
    color: #fbbf24;
    animation: zap-strike 5s ease-in-out infinite;
  }

  @keyframes zap-strike {
    0%, 70%, 100% {
      transform: scale(1);
      color: #fbbf24;
      filter: drop-shadow(0 0 0px transparent);
    }
    76% {
      transform: scale(1.35) rotate(-10deg);
      color: #fff;
      filter: drop-shadow(0 0 5px #fbbf24);
    }
    82% {
      transform: scale(0.9) rotate(4deg);
      color: #fde68a;
      filter: drop-shadow(0 0 2px #fbbf24);
    }
    88% {
      transform: scale(1.2);
      color: #fff;
      filter: drop-shadow(0 0 8px #fde68a);
    }
    94% {
      transform: scale(1);
      color: #fbbf24;
      filter: drop-shadow(0 0 0px transparent);
    }
  }

  /* ── Astro icon & text ── */
  .astro-link {
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .astro-icon {
    color: #ff5d01;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .astro-link:hover .astro-icon {
    animation: rocket-launch 1.1s ease-out forwards;
  }

  @keyframes rocket-launch {
    /* shake phase — rocket revving up */
    0%   { transform: translateX(0)    translateY(0)    rotate(0deg)  scale(1);    }
    8%   { transform: translateX(-2px) translateY(1px)  rotate(-5deg) scale(1);    }
    16%  { transform: translateX(2px)  translateY(1px)  rotate(5deg)  scale(1);    }
    24%  { transform: translateX(-2px) translateY(0)    rotate(-4deg) scale(1);    }
    32%  { transform: translateX(2px)  translateY(1px)  rotate(4deg)  scale(1);    }
    40%  { transform: translateX(-1px) translateY(0)    rotate(-3deg) scale(1.02); }
    48%  { transform: translateX(1px)  translateY(0)    rotate(2deg)  scale(1.03); }
    /* launch phase — lift off */
    58%  { transform: translateX(0)    translateY(-2px) rotate(0deg)  scale(1.07); }
    72%  { transform: translateX(0)    translateY(-5px) rotate(0deg)  scale(1.13); filter: drop-shadow(0 2px 4px #ff5d0166); }
    85%  { transform: translateX(0)    translateY(-8px) rotate(0deg)  scale(1.18); filter: drop-shadow(0 3px 7px #ff5d0199); }
    100% { transform: translateX(0)    translateY(-5px) rotate(0deg)  scale(1.13); filter: drop-shadow(0 2px 6px #ff5d0177); }
  }
</style>
