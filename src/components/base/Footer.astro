---
import { SITE } from '~/config'
import { execSync } from 'node:child_process'
import IconHeart from '~/assets/icons/IconHeart.svg'
import IconAstro from '~/assets/icons/IconAstro.svg'

const currentYear = new Date().getFullYear()
const copyrightText = `© ${currentYear} ${SITE.author}`

let commitHash = 'unknown'
try {
  commitHash =
    import.meta.env.PUBLIC_GIT_SHA ||
    import.meta.env.VERCEL_GIT_COMMIT_SHA ||
    import.meta.env.GIT_COMMIT_HASH
  if (!commitHash) {
    commitHash = execSync('git rev-parse --short HEAD').toString().trim()
  } else {
    commitHash = commitHash.substring(0, 7)
  }
} catch {
  // fallback if git is not available
}

const githubRepo = 'https://github.com/devadathanmb/personal-blog-v2'
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div class="prose mx-auto op-50">
    <div
      class="flex flex-col sm:flex-row sm:justify-between items-center text-sm whitespace-nowrap"
    >
      <div class="flex lt-sm:flex-col items-center gap-1">
        <span>{copyrightText}</span>
        <span class="lt-sm:hidden">&nbsp;|&nbsp;</span>
        <span class="flex items-center gap-1">
          Built with
          <IconHeart class="heart-icon" aria-hidden="true" />
          using
          <a
            href="https://astro.build"
            target="_blank"
            rel="noopener noreferrer"
            class="astro-link inline-flex items-center gap-1"
            title="Built with Astro"
          >
            <IconAstro class="astro-icon" aria-hidden="true" />
          </a>
        </span>
      </div>
      {
        commitHash !== 'unknown' && (
          <div class="mt-2 sm:mt-0 flex items-center gap-1">
            <span>⚡️ Deployed commit:</span>
            <a
              class="shine-hash font-mono decoration-dashed hover:decoration-solid underline underline-offset-2"
              href={`${githubRepo}/commit/${commitHash}`}
              target="_blank"
              rel="noopener noreferrer"
              title="View commit on GitHub"
            >
              {commitHash}
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>

<style>
  /* ── Shine animation on commit hash ── */
  @keyframes shine {
    from {
      background-position: 250% center;
    }
    to {
      background-position: -250% center;
    }
  }

  .shine-hash {
    --shine-dim: rgba(200, 200, 200, 0.75);
    --shine-bright: rgb(255, 255, 255);
    --shine-glow: rgba(230, 230, 230, 0.95);
    display: inline-block;
    background: linear-gradient(
      110deg,
      var(--shine-dim) 0%,
      var(--shine-dim) 35%,
      var(--shine-glow) 45%,
      var(--shine-bright) 50%,
      var(--shine-glow) 55%,
      var(--shine-dim) 65%,
      var(--shine-dim) 100%
    );
    background-size: 250% auto;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shine 8s linear infinite;
  }

  /* Light mode: dark shine passes through */
  :root:not(.dark) .shine-hash {
    --shine-dim: rgba(80, 80, 80, 0.7);
    --shine-bright: rgb(0, 0, 0);
    --shine-glow: rgba(60, 60, 60, 0.9);
  }

  .shine-hash:hover {
    animation-play-state: paused;
  }

  /* ── Heart icon ── */
  .heart-icon {
    color: #ef4444;
    width: 0.9rem;
    height: 0.9rem;
    animation: heartbeat 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes heartbeat {
    0%,
    100% {
      transform: scale(1);
    }
    14% {
      transform: scale(1.15);
    }
    28% {
      transform: scale(1);
    }
    42% {
      transform: scale(1.1);
    }
    56% {
      transform: scale(1);
    }
  }

  /* ── Astro icon & text ── */
  .astro-link {
    text-decoration: none !important;
    border-bottom: none !important;
  }

  .astro-icon {
    color: #ff5d01;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .astro-link:hover .astro-icon {
    transform: rotate(12deg) scale(1.15);
  }
</style>
