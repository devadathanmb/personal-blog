---
import { slugifyStr } from "@/utils/slugify";
import type { CollectionEntry } from "astro:content";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";
import { calculateReadingTime } from "@/utils/readingTime";

export interface Props extends CollectionEntry<"blog"> {
  variant?: "h2" | "h3";
}

const { variant = "h2", data, id, filePath, body } = Astro.props;

const { title, description, pubDatetime, modDatetime, timezone } = data;
const readingTime = calculateReadingTime(body);

const headerProps = {
  style: { viewTransitionName: slugifyStr(title) },
  class:
    "text-lg font-medium tracking-tight decoration-dashed group-hover:underline",
};
---

<li
  class="group my-8 border-l-2 border-transparent pl-3 transition-all duration-200 hover:border-accent/60"
>
  <a
    href={getPath(id, filePath)}
    class="inline-block text-lg font-medium text-accent focus-visible:no-underline"
  >
    {
      variant === "h2" ? (
        <h2 {...headerProps}>{title}</h2>
      ) : (
        <h3 {...headerProps}>{title}</h3>
      )
    }
  </a>
  <Datetime {pubDatetime} {modDatetime} {timezone} {readingTime} />
  <p class="mt-2 text-foreground/95">{description}</p>
</li>
