---
import PanelOpenButton from '~/components/base/PanelOpenButton.astro'

interface Props {
  stacked?: boolean
}

const { stacked = false } = Astro.props
---

<PanelOpenButton
  buttonId="tag-open-button"
  panelId="tag-panel"
  bottom={stacked ? '7.5rem' : '4.5rem'}
  label="Open tags filter"
>
  <div u-i-ri-price-tag-3-line class="text-gray-700 dark:text-gray-200"></div>
</PanelOpenButton>
